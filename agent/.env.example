# 日志：级别 DEBUG|INFO|WARNING|ERROR（默认 INFO）；目录为项目下 LOG_DIR，默认 logs
# LOG_LEVEL=INFO
# LOG_DIR=logs
# 若 .env 某行报解析错误，请对含等号的值加引号，例如：KEY="value=with=equals"

# 可选：Gunicorn 启动时使用（见 README「方式二：生产 / 多进程」）
# GUNICORN_BIND=0.0.0.0:8001
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120

# 必填：阿里云 DashScope API Key（调用 Qwen 模型）
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-

# 模型名称：qwen-plus（推荐）或 qwen-turbo
MODEL_NAME=qwen-plus

# OCR 引擎选择（可选，覆盖 ocr_config.yaml 中的 engine）
# 可选值：baidu | paddle | qwen_vl
# OCR_ENGINE=baidu

# OCR 插图保存目录与返回给前端的 URL 前缀（题目中的明显插图会截取保存并返回链接）
# OCR_FIGURES_DIR=uploads/ocr_figures
# OCR_FIGURES_URL_PREFIX=/uploads/ocr_figures

# 可选：百度 OCR（当 engine=baidu 时使用）
# 获取地址：https://cloud.baidu.com/product/ocr
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=

# 可选：阿里云 TTS（语音合成，用于个性化内容朗读，需智能语音交互控制台创建项目获取 AppKey）
# ALIYUN_TTS_ACCESS_KEY_ID=
# ALIYUN_TTS_ACCESS_KEY_SECRET=
# ALIYUN_TTS_APPKEY=
# ALIYUN_TTS_REGION=cn-shanghai
# 单次请求最大字符数（超出时自动分批合成并拼接），默认从 configs/tts_config.yaml 读取
# ALIYUN_TTS_MAX_CHARS_PER_REQUEST=300

# 可选：漫画/插图生成（TTAPI Midjourney 或 Gemini/Imagen）
# TTAPI（Midjourney）：https://ttapi.io 获取 API Key
# TTAPI_API_KEY=
# TTAPI_BASE_URL=https://api.ttapi.io
# Gemini/Imagen：https://ai.google.dev 获取 API Key，需安装 google-genai
# GEMINI_API_KEY=

# 可选：文档数据目录（RAG 文档加载用）
# DATA_DIR=./data
# 可选：Redis URL（异步任务与缓存）
# REDIS_URL=redis://localhost:6379/0

# 可选：Milvus 连接（向量检索）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# --- Coze 定时任务（可选，见 scripts/openclaw_daily_coze_job.py）---
# COZE_API_TOKEN=
# COZE_WORKFLOW_ID=
# COZE_APP_ID=

# --- 小红书开放平台（可选 / 遗留；自动发帖用 xiaohongshu-mcp，见 marketing/XHS_MCP_PUBLISH.md）---
# XHS_APP_ID=
# XHS_APP_SECRET=
# XHS_ACCESS_TOKEN=
# XHS_REFRESH_TOKEN=
# XHS_TOKEN_CACHE_PATH=marketing/xiaohongshu/.token_cache.json

