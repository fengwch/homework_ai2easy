<script lang="uts">
  import { state, updateGlobalData, setLifeCycleNum, checkSystemTheme } from '@/store/index.uts'
  import { useUserStore } from '@/stores/user'

  // #ifdef APP-ANDROID || APP-HARMONY
  let firstBackTime = 0
  // #endif

  function getRedirectUrl(scheme : string | null, ulink : string | null) : string | null {
    let url : string | null = null
    if (null != scheme && scheme.length > 0) {
      const PATHPRE = 'redirect'
      let parts : string | null = null
      const pos = scheme.search('//')
      if (pos > 0) {
        parts = scheme.substring(pos + 2)
      }
      if (null != parts && parts.startsWith(PATHPRE)) {
        url = parts.substring(PATHPRE.length)
      }
    } else if (null != ulink && ulink.length > 0) {
      const PATH = 'ulink/redirect.html'
      const parts = ulink.split('?')
      if (parts.length > 1 && parts[0].endsWith(PATH) && parts[1].length > 0) {
        parts[1].split('&').forEach((e) => {
          const params = e.split('=')
          if (params.length > 1 && params[0].length > 0 && params[1].length > 0) {
            if ('url' == params[0]) {
              if (null == url) {
                url = decodeURIComponent(params[1])
              }
            }
          }
        })
      }
    }
    return url
  }

  export default {
    onLaunch(res : OnLaunchOptions) {
      console.log('[App.onLaunch] start')
      updateGlobalData('launchOptions', res)
      setLifeCycleNum(state.lifeCycleNum + 1000)
      console.log('App Launch')
      // #ifdef APP-ANDROID || APP-IOS || WEB || APP-HARMONY
      // 未使用 uni-stat 云函数，MP-WEIXIN 已排除，避免 404
      uni.report({
        name: 'uni-app-launch',
        options: res,
        success(res_data) {
          console.log(res_data)
        },
        fail(err) {
          console.log(err)
        }
      })
      // #endif
      // #ifdef APP
      if (process.env.NODE_ENV !== 'development') {
        uni.getPrivacySetting({
          success(res1) {
            if (res1.needAuthorization) {
              uni.openDialogPage({
                url: '/pages/component/button/privacy'
              })
            }
          }
        })
      }
      // #endif
      checkSystemTheme()
      // #ifdef MP-WEIXIN
      // 小程序下每次启动都尝试微信静默登录，刷新会话（避免旧 token 过期仍不刷新）
      const userStore = useUserStore()
      userStore.wechatAutoLogin()
      // #endif
    },
    onShow(res : OnShowOptions) {
      updateGlobalData('showOptions', res)
      const url = getRedirectUrl(res.appScheme, res.appLink)
      if (null != url) {
        uni.navigateTo({
          url: url
        })
      }
      setLifeCycleNum(state.lifeCycleNum + 100)
      console.log('App Show')
      // #ifdef APP-ANDROID || APP-IOS || WEB || APP-HARMONY
      uni.report({
        name: 'uni-app-show',
        success(res_data) {
          console.log(res_data)
        },
        fail(err) {
          console.log(err)
        }
      })
      // #endif
    },
    onHide() {
      setLifeCycleNum(state.lifeCycleNum - 100)
      console.log('App Hide')
      // #ifdef APP-ANDROID || APP-IOS || WEB || APP-HARMONY
      uni.report({
        name: 'uni-app-hide',
        success(res) {
          console.log(res)
        },
        fail(err) {
          console.log(err)
        }
      })
      // #endif
    },
    // #ifdef APP-ANDROID || APP-HARMONY
    onLastPageBackPress() {
      setLifeCycleNum(state.lifeCycleNum - 1000)
      console.log('App LastPageBackPress')
      if (firstBackTime == 0) {
        uni.showToast({
          title: '再按一次退出应用',
          position: 'bottom'
        })
        firstBackTime = Date.now()
        setTimeout(() => {
          firstBackTime = 0
        }, 2000)
      } else if (Date.now() - firstBackTime < 2000) {
        firstBackTime = Date.now()
        uni.exit()
      }
    },
    onExit() {
      console.log('App Exit')
    },
    // #endif
    onError(err : any) {
      console.log('App Error', err)
      setLifeCycleNum(state.lifeCycleNum + 100)
      // #ifdef APP-ANDROID || APP-IOS || WEB || MP-WEIXIN || APP-HARMONY
      uni.report({
        name: 'uni-app-error',
        options: err,
        success(res) {
          console.log(res)
        },
        fail(err) {
          console.log(err)
        }
      })
      // #endif
    },
    methods: {
      increaseLifeCycleNum() {
        setLifeCycleNum(state.lifeCycleNum + 100)
        console.log('App increaseLifeCycleNum')
      }
    }
  }
</script>

<style>
  /*每个页面公共css */
  @import "./common/uni.css";

  /* #ifdef WEB */
  .uni-top-window uni-tabbar .uni-tabbar {
    background-color: #fff !important;
  }
  /* #endif */
  /* #ifdef MP-WEIXIN */
  page {
    background-color: #efeff4;
  }
  /* #endif */

  .global-text {
  	color: #007AFF;
  	font-size: 16px;
  	font-weight: bold;
  }

  .global-box {
  	background-color: #E1F5FF;
  	padding: 10px;
  	margin: 10px;
  	border-radius: 8px;
  	border: 2px solid #007AFF;
  }
</style>
