<template>
  <view class="interest-selector">
    <text class="title">{{ title || '选择兴趣爱好' }}</text>
    <text class="subtitle">最多选择{{ maxCount }}个</text>
    
    <view class="tags-container">
      <view
        v-for="tag in presetTags"
        :key="tag"
        class="tag"
        :class="{ active: selectedTags.includes(tag) }"
        @click="toggleTag(tag)"
      >
        {{ tag }}
      </view>
    </view>
    
    <view v-if="allowCustom" class="custom-section">
      <text class="custom-title">自定义标签（最多{{ maxCustomCount }}个）</text>
      <view class="custom-tags">
        <view
          v-for="(tag, index) in customTags"
          :key="index"
          class="custom-tag"
        >
          <text>{{ tag }}</text>
          <text class="remove-icon" @click="removeCustomTag(index)">×</text>
        </view>
        <input
          v-if="customTags.length < maxCustomCount"
          v-model="customInput"
          placeholder="输入自定义标签"
          maxlength="5"
          class="custom-input"
          @confirm="addCustomTag"
        />
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, watch } from 'vue'

interface Props {
  modelValue: string[]
  presetTags?: string[]
  maxCount?: number
  allowCustom?: boolean
  maxCustomCount?: number
  title?: string
}

const props = withDefaults(defineProps<Props>(), {
  modelValue: () => [],
  presetTags: () => [
    '阅读', '绘画', '音乐', '运动', '科学', '数学', '英语', '编程',
    '手工', '舞蹈', '书法', '棋类', '积木', '拼图', '游戏'
  ],
  maxCount: 5,
  allowCustom: true,
  maxCustomCount: 3,
  title: '选择兴趣爱好'
})

const emit = defineEmits<{
  'update:modelValue': [value: string[]]
}>()

const selectedTags = ref<string[]>([...props.modelValue])
const customTags = ref<string[]>([])
const customInput = ref('')

// 分离预设标签和自定义标签
watch(() => props.modelValue, (newVal) => {
  const preset = props.presetTags || []
  selectedTags.value = newVal.filter(tag => preset.includes(tag))
  customTags.value = newVal.filter(tag => !preset.includes(tag))
}, { immediate: true })

function toggleTag(tag: string) {
  const index = selectedTags.value.indexOf(tag)
  if (index > -1) {
    selectedTags.value.splice(index, 1)
  } else {
    if (selectedTags.value.length + customTags.value.length < props.maxCount) {
      selectedTags.value.push(tag)
    } else {
      uni.showToast({
        title: `最多只能选择${props.maxCount}个`,
        icon: 'none'
      })
      return
    }
  }
  updateValue()
}

function addCustomTag() {
  const tag = customInput.value.trim()
  if (!tag) return
  
  if (customTags.value.length >= props.maxCustomCount) {
    uni.showToast({
      title: `最多只能添加${props.maxCustomCount}个自定义标签`,
      icon: 'none'
    })
    return
  }
  
  if (selectedTags.value.length + customTags.value.length >= props.maxCount) {
    uni.showToast({
      title: `最多只能选择${props.maxCount}个`,
      icon: 'none'
    })
    return
  }
  
  if (customTags.value.includes(tag)) {
    uni.showToast({
      title: '该标签已存在',
      icon: 'none'
    })
    return
  }
  
  customTags.value.push(tag)
  customInput.value = ''
  updateValue()
}

function removeCustomTag(index: number) {
  customTags.value.splice(index, 1)
  updateValue()
}

function updateValue() {
  const allTags = [...selectedTags.value, ...customTags.value]
  emit('update:modelValue', allTags)
}
</script>

<style scoped lang="scss">
.interest-selector {
  padding: 32rpx 0;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 24rpx;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.tag.active {
  background: #667eea;
  color: #fff;
  border-color: #667eea;
}

.custom-section {
  margin-top: 40rpx;
}

.custom-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.custom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

.custom-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #e8f4ff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #667eea;
}

.remove-icon {
  font-size: 32rpx;
  color: #999;
  line-height: 1;
  cursor: pointer;
}

.custom-input {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  min-width: 200rpx;
  border: 2rpx solid #e5e5e5;
}
</style>
