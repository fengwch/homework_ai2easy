<template>
  <view class="tab-bar">
    <view class="tab-item" :class="{ active: current === 'home' }" @click="goHome">
      <text class="tab-icon">🏠</text>
      <text class="tab-text">首页</text>
    </view>
    <view class="tab-item tab-add" :class="{ active: current === 'add' }" @click="goAdd">
      <text class="tab-icon">➕</text>
      <text class="tab-text">添加小孩</text>
    </view>
    <view class="tab-item" :class="{ active: current === 'profile' }" @click="goProfile">
      <text class="tab-icon">👤</text>
      <text class="tab-text">我的</text>
    </view>
  </view>
</template>

<script setup lang="uts">
withDefaults(defineProps<{
  current?: 'home' | 'add' | 'profile'
}>(), { current: 'home' })

function goHome() {
  uni.reLaunch({ url: '/pages/child/list' })
}

function goAdd() {
  uni.navigateTo({ url: '/pages/child/edit?mode=create' })
}

function goProfile() {
  uni.reLaunch({ url: '/pages/profile/index' })
}
</script>

