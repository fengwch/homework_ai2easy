  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.error-text {
  font-size: 32rpx;
  color: #f56c6c;
  margin-bottom: 16rpx;
}

.error-sub-text {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.retry-btn {
  padding: 20rpx 48rpx;
  background: #667eea;
  color: #fff;
