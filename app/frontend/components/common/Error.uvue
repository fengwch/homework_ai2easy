<template>
  <view class="error-container">
    <image v-if="icon" :src="icon" class="error-icon" mode="aspectFit" />
    <text class="error-text">{{ text || '出错了' }}</text>
    <text v-if="subText" class="error-sub-text">{{ subText }}</text>
    <button v-if="showRetry" class="retry-btn" @click="handleRetry">重试</button>
    <slot name="action"></slot>
  </view>
</template>

<script setup lang="uts">
interface Props {
  text?: string
  subText?: string
  icon?: string
  showRetry?: boolean
}

const props = withDefaults(defineProps<Props>(), {
  text: '出错了',
  subText: '',
  icon: '',
  showRetry: true
})

const emit = defineEmits<{
  retry: []
}>()

function handleRetry() {
  emit('retry')
}
</script>

