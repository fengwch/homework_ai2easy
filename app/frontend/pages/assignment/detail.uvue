<template>
  <view class="container">
    <view v-if="loading" class="loading">
      <text>加载中...</text>
    </view>
    
    <view v-else-if="assignment" class="content">
      <!-- 作业信息 -->
      <view class="header">
        <text class="title">{{ assignment.subject }}作业</text>
      </view>

      <!-- 原始图片（相对路径会解析为后端地址，避免请求到前端域名 404） -->
      <view v-if="assignmentOriginalImages.length > 0" class="section">
        <text class="section-title">原始图片</text>
        <scroll-view scroll-x class="image-scroll">
          <image
            v-for="(img, index) in assignmentOriginalImages"
            :key="index"
            :src="resolveResourceUrl(img)"
            mode="widthFix"
            class="preview-image"
            @click="previewImage(resolveResourceUrl(img), assignmentOriginalImages.map(resolveResourceUrl))"
          />
        </scroll-view>
      </view>

      <!-- 识别结果 -->
      <view v-if="assignment.questions && assignment.questions.length > 0" class="section">
        <view class="section-header">
          <text class="section-title">识别结果（{{ assignment.questions.length }}题）</text>
          <button class="edit-btn" @click="showEditModal = true">编辑</button>
        </view>
        
        <view
          v-for="(question, index) in assignment.questions"
          :key="question.id || index"
          class="question-item"
        >
          <view class="question-header">
            <text class="question-number">第{{ question.questionNumber || index + 1 }}题</text>
            <text class="question-type">{{ getQuestionTypeText(question.questionType) }}</text>
          </view>
          <text class="question-text">{{ question.originalText }}</text>
          <view class="question-actions">
            <button
              v-if="getQuestionStoryId(question)"
              class="question-action-btn story-btn"
              @click="goToQuestionLearning(getQuestionStoryId(question)!, index, question.id)"
            >
              开始学习
            </button>
            <button
              v-else
              class="question-action-btn generate-btn"
              :disabled="getQuestionGenStatus(question) === 'processing'"
              @click="generateForQuestion(index)"
            >
              {{ getQuestionGenStatus(question) === 'processing' ? '生成中...' : '生成内容' }}
            </button>
            <text
              v-if="getQuestionGenStatus(question) === 'completed' && getQuestionImageStatus(question) !== 'none'"
              class="question-image-status"
            >
              配图生成：{{ formatImageStatusText(getQuestionImageStatus(question), getQuestionImageProgress(question)) }}
            </text>
            <text
              v-else-if="getQuestionGenStatus(question) !== 'none' && getQuestionGenStatus(question) !== 'completed'"
              class="question-image-status"
            >
              插图生成中
            </text>
          </view>
        </view>
      </view>

      <!-- 待处理时：开始识别 -->
      <view v-if="assignment.status === 'pending'" class="actions">
        <button
          class="primary-btn"
          :disabled="scanning"
          @click="handleStartScan"
        >
          {{ scanning ? '识别中...' : '开始识别' }}
        </button>
        <text class="action-hint">上传后需触发识别</text>
      </view>

      <!-- 操作按钮 -->
      <view v-else class="actions">
        <button
          v-if="assignment.status === 'completed' && !hasGeneratedContent"
          class="primary-btn"
          :disabled="generating"
          @click="handleGenerateContent"
        >
          {{ generating ? '生成中...' : '生成个性化内容' }}
        </button>
        <text
          v-if="assignmentImageStatus"
          class="assignment-image-status"
        >
          配图生成：{{ formatImageStatusText(assignmentImageStatus, assignmentImageProgress) }}
        </text>
        
        <button
          v-if="hasGeneratedContent"
          class="primary-btn"
          @click="goToLearning"
        >
          开始学习
        </button>
        
        <button
          v-if="hasGeneratedContent"
          class="secondary-btn"
          @click="goToPrint"
        >
          打印学习材料
        </button>

        <button
          v-if="assignment.questions && assignment.questions.length > 0"
          class="outline-btn"
          @click="goToAnswer"
        >
          直接做题
        </button>
      </view>
    </view>

    <!-- 编辑模态框 -->
    <view v-if="showEditModal" class="modal" @click="showEditModal = false">
      <view class="modal-content" @click.stop>
        <text class="modal-title">编辑识别结果</text>
        <text class="modal-hint">此功能开发中...</text>
        <button class="modal-btn" @click="showEditModal = false">关闭</button>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue'
import { onHide, onUnload } from '@dcloudio/uni-app'
import {
  fetchAssignmentDetail,
  generateContent,
  triggerAssignmentScan,
  getScanStatus,
  getGenerateStatus,
  generateQuestionContent,
  getQuestionGenerateStatus
} from '@/api/assignment'
import type { AssignmentDetail } from '@/api/assignment'
import { resolveResourceUrl } from '@/utils/image'

const assignment = ref<AssignmentDetail | null>(null)
const loading = ref(true)
const generating = ref(false)
const scanning = ref(false)
const showEditModal = ref(false)

// 作业级图片生成状态（用于在「生成内容」旁单独展示配图生成进度）
const assignmentImageStatus = ref<string | null>(null)
const assignmentImageProgress = ref<number | null>(null)

// 兼容后端返回 original_images 或 originalImages
const assignmentOriginalImages = computed(() => {
  const a = assignment.value
  if (!a) return []
  const imgs = (a as any).originalImages ?? (a as any).original_images ?? []
  return Array.isArray(imgs) ? imgs : []
})

// 是否已有生成内容（兼容 storyId/story_id）
const hasGeneratedContent = computed(() => {
  const gc = assignment.value?.generatedContent ?? (assignment.value as any)?.generated_content
  if (!gc) return false
  const status = gc.status ?? (gc as any).status
  const sid = (gc as any).storyId ?? (gc as any).story_id
  return status === 'completed' && !!sid
})

onMounted(() => {
  loadAssignment()
})

/** 恢复处于「生成中」的题目的轮询（用于 onShow 与 loadAssignment 完成后） */
function resumePollingForProcessingQuestions() {
  const a = assignment.value
  if (!a?.questions) return
  for (let i = 0; i < a.questions.length; i++) {
    if (getQuestionGenStatus(a.questions[i]) === 'processing') {
      pollQuestionGenerateStatus(i)
    }
  }
}

/** 页面重新显示时恢复处于「生成中」的题目的轮询，避免离开再返回后按钮不更新 */
onShow(() => {
  resumePollingForProcessingQuestions()
})

function loadAssignment() {
  // 获取页面参数
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = currentPage.options || {}
  const id = parseInt(options.id || '0')
  
  if (!id) {
    uni.showToast({
      title: '作业ID无效',
      icon: 'none'
    })
    setTimeout(() => {
      uni.navigateBack()
    }, 1500)
    return
  }
  
  loading.value = true
  fetchAssignmentDetail(id)
    .then((data) => {
      assignment.value = data
      resumePollingForProcessingQuestions()
    })
    .catch((err) => {
      console.error('加载作业详情失败:', err)
      uni.showToast({
        title: '加载失败',
        icon: 'none'
      })
      // 使用 mock 数据
      assignment.value = {
        id,
        childId: 1,
        subject: '数学',
        grade: '三年级',
        originalImages: [],
        questions: [
          {
            id: '1',
            questionNumber: 1,
            questionType: 'calculation',
            originalText: '5 + 3 = ?',
            structuredData: {
              stem: '5 + 3 = ?',
              answer: '8'
            },
            knowledgePoints: [
              {
                subject: '数学',
                topic: '加减法',
                subtopic: '20以内加减法',
                difficulty: 'easy'
              }
            ]
          }
        ],
        status: 'completed',
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
      }
    })
    .finally(() => {
      loading.value = false
    })
}

function getStatusText(status: string) {
  const statusMap: Record<string, string> = {
    pending: '待处理',
    processing: '处理中',
    completed: '已完成',
    failed: '失败'
  }
  return statusMap[status] || status
}

/** 待处理时点击「开始识别」：调用后端按作业ID触发识别，并轮询进度后刷新详情 */
async function handleStartScan() {
  if (!assignment.value || assignment.value.status !== 'pending' || scanning.value) return
  scanning.value = true
  const assignmentId = assignment.value.id
  const subject = (assignment.value as any).subject || '数学'
  try {
    await triggerAssignmentScan(assignmentId, subject)
    uni.showToast({ title: '已提交识别', icon: 'success' })
    pollScanStatus(assignmentId)
  } catch (err: any) {
    console.error('触发识别失败:', err)
    scanning.value = false
    uni.showToast({
      title: err?.message || '触发识别失败，请确认后端已实现 POST /api/v1/assignments/{id}/scan',
      icon: 'none',
      duration: 3500
    })
  }
}

const POLL_INTERVAL = 2000
let pollTimer: ReturnType<typeof setTimeout> | null = null

function pollScanStatus(id: number) {
  if (pollTimer) clearTimeout(pollTimer)
  getScanStatus(id)
    .then((data: any) => {
      const status = data.status ?? data.scan_status
      if (status === 'complete' || status === 'completed') {
        scanning.value = false
        uni.showToast({ title: '识别完成', icon: 'success' })
        loadAssignment()
        return
      }
      if (status === 'error' || status === 'failed') {
        scanning.value = false
        uni.showToast({ title: '识别失败', icon: 'none' })
        loadAssignment()
        return
      }
      pollTimer = setTimeout(() => pollScanStatus(id), POLL_INTERVAL)
    })
    .catch(() => {
      pollTimer = setTimeout(() => pollScanStatus(id), POLL_INTERVAL)
    })
}

function getQuestionTypeText(type: string) {
  const typeMap: Record<string, string> = {
    multiple_choice: '选择题',
    fill_blank: '填空题',
    calculation: '计算题',
    word_problem: '应用题',
    essay: '问答题'
  }
  return typeMap[type] || type
}

function previewImage(current: string, urls: string[]) {
  uni.previewImage({
    current,
    urls
  })
}

async function handleGenerateContent() {
  if (!assignment.value) return
  
  generating.value = true
  assignmentImageStatus.value = null
  assignmentImageProgress.value = null
  try {
    await generateContent(assignment.value.id)
    uni.showToast({
      title: '开始生成内容',
      icon: 'success'
    })
    pollGenerateStatus(assignment.value.id)
  } catch (err) {
    console.error('生成内容失败:', err)
    generating.value = false
    uni.showToast({
      title: '生成失败，请重试',
      icon: 'none'
    })
  }
}

const GEN_POLL_INTERVAL = 2000
let genPollTimer: ReturnType<typeof setTimeout> | null = null
const GEN_QUESTION_POLL_INTERVAL = 2000
const genQuestionPollTimers: Record<string, ReturnType<typeof setTimeout>> = {}

/** 离开详情页（如进入故事学习）时停止作业级/单题级 generate-status 轮询，避免与故事页重复请求 */
function clearAllGeneratePollTimers() {
  if (genPollTimer) {
    clearTimeout(genPollTimer)
    genPollTimer = null
  }
  Object.keys(genQuestionPollTimers).forEach((k) => {
    if (genQuestionPollTimers[k]) clearTimeout(genQuestionPollTimers[k])
    delete genQuestionPollTimers[k]
  })
}

onHide(() => {
  clearAllGeneratePollTimers()
})

onUnload(() => {
  clearAllGeneratePollTimers()
})

/** 通用：格式化图片生成状态 + 进度，供作业级与单题级复用 */
function formatImageStatusText(status: string | null, progress?: number | null): string {
  if (!status || status === 'none') return ''
  const percent = typeof progress === 'number' && progress >= 0 ? `${progress}%` : ''
  if (status === 'pending') return '待生成'
  if (status === 'processing') return percent ? `生成中（${percent}）` : '生成中'
  if (status === 'completed') return '已完成'
  if (status === 'failed') return '生成失败'
  return status
}

function pollGenerateStatus(id: number) {
  if (genPollTimer) clearTimeout(genPollTimer)
  getGenerateStatus(id)
    .then((data: any) => {
      const status = data.status
      const progress = data.progress ?? 0
      const storyId = data.story_id ?? data.storyId
      const imgStatus = data.imageStatus ?? data.image_status ?? null
      const imgProgressRaw = data.imageProgress ?? data.image_progress

      assignmentImageStatus.value = imgStatus
      assignmentImageProgress.value = typeof imgProgressRaw === 'number' ? imgProgressRaw : null
      const textDone = (status === 'completed' || progress >= 100) && !!storyId
      const imageDoneOrNotNeeded =
        !imgStatus && assignmentImageProgress.value == null
          || imgStatus === 'completed'
          || imgStatus === 'failed'
          || (typeof assignmentImageProgress.value === 'number' && assignmentImageProgress.value >= 100)

      if (status === 'failed') {
        generating.value = false
        uni.showToast({ title: '生成失败', icon: 'none' })
        return
      }
      // 文本生成完成后，立即解锁「开始学习」等入口，但继续轮询图片进度
      if (textDone && assignment.value) {
        const gc = { story_id: storyId, storyId, status: 'completed' }
        assignment.value = {
          ...assignment.value,
          generatedContent: gc,
          generated_content: gc
        } as AssignmentDetail
        generating.value = false
      }
      // 文本和配图都完成（或无需配图）时，结束轮询并提示
      if (textDone && imageDoneOrNotNeeded) {
        uni.showToast({ title: '内容生成完成', icon: 'success' })
        return
      }
      genPollTimer = setTimeout(() => pollGenerateStatus(id), GEN_POLL_INTERVAL)
    })
    .catch(() => {
      genPollTimer = setTimeout(() => pollGenerateStatus(id), GEN_POLL_INTERVAL)
    })
}

function goToLearning() {
  const gc = assignment.value?.generatedContent
  const sid = (gc as any)?.storyId ?? (gc as any)?.story_id
  if (sid && assignment.value) {
    uni.navigateTo({
      url: `/pages/learning/story?storyId=${sid}&assignmentId=${assignment.value.id}`
    })
  }
}

/** 获取题目维度的 story_id（兼容 generated_content.story_id / storyId） */
function getQuestionStoryId(q: any): string | null {
  const gc = q?.generated_content ?? q?.generatedContent
  if (!gc) return null
  const sid = gc.story_id ?? gc.storyId
  return sid && (gc.status === 'completed' || !gc.status) ? sid : null
}

/** 获取题目维度的生成状态 */
function getQuestionGenStatus(q: any): string {
  const gc = q?.generated_content ?? q?.generatedContent
  if (!gc) return 'none'
  return gc.status ?? 'none'
}

/** 获取题目维度的图片生成状态 */
function getQuestionImageStatus(q: any): string {
  const gc = q?.generated_content ?? q?.generatedContent
  if (!gc) return 'none'
  return gc.imageStatus ?? gc.image_status ?? 'none'
}

/** 获取题目维度的图片生成进度 */
function getQuestionImageProgress(q: any): number | null {
  const gc = q?.generated_content ?? q?.generatedContent
  if (!gc) return null
  const p = gc.imageProgress ?? gc.image_progress
  return typeof p === 'number' ? p : null
}

async function generateForQuestion(index: number) {
  const a = assignment.value
  if (!a?.questions) return
  const q = a.questions[index]
  if (!q) return
  const qid = typeof q.id === 'string' ? q.id : String(q.id)
  if (getQuestionGenStatus(q) === 'processing') return

  try {
    await generateQuestionContent(a.id, qid)
    setQuestionGenStatus(index, 'processing')
    uni.showToast({ title: '开始生成', icon: 'success' })
    pollQuestionGenerateStatus(index)
  } catch (err) {
    console.error('生成失败:', err)
    uni.showToast({ title: '生成失败，请重试', icon: 'none' })
  }
}

function setQuestionGenStatus(
  index: number,
  status: string,
  storyId?: string,
  imageStatus?: string | null,
  imageProgress?: number | null
) {
  const a = assignment.value
  if (!a?.questions?.[index]) return
  const q = a.questions[index] as any
  const gc = q.generated_content ?? q.generatedContent ?? {}
  a.questions[index] = {
    ...q,
    generated_content: {
      ...gc,
      status,
      story_id: storyId ?? gc.story_id,
      storyId: storyId ?? gc.storyId,
      image_status: imageStatus ?? gc.image_status,
      imageStatus: imageStatus ?? gc.imageStatus,
      image_progress: imageProgress ?? gc.image_progress,
      imageProgress: imageProgress ?? gc.imageProgress
    }
  }
}

function pollQuestionGenerateStatus(index: number) {
  const a = assignment.value
  if (!a?.questions?.[index]) return
  const q = a.questions[index]
  const qid = typeof q.id === 'string' ? q.id : String(q.id)

  if (genQuestionPollTimers[qid]) clearTimeout(genQuestionPollTimers[qid])

  getQuestionGenerateStatus(a.id, qid)
    .then((data: any) => {
      const status = data.status
      const progress = data.progress ?? 0
      const storyId = data.story_id ?? data.storyId
      const imageStatus = data.imageStatus ?? data.image_status ?? null
      const imageProgressRaw = data.imageProgress ?? data.image_progress
      const imageProgress = typeof imageProgressRaw === 'number' ? imageProgressRaw : null
      const textDone = (status === 'completed' || progress >= 100) && !!storyId
      const imageDoneOrNotNeeded =
        !imageStatus && imageProgress == null
          || imageStatus === 'completed'
          || imageStatus === 'failed'
          || (typeof imageProgress === 'number' && imageProgress >= 100)

      if (status === 'failed') {
        setQuestionGenStatus(index, 'failed', undefined, imageStatus ?? 'failed', imageProgress)
        delete genQuestionPollTimers[qid]
        uni.showToast({ title: '生成失败', icon: 'none' })
        return
      }
      // 文本完成但配图仍在生成：先标记题目状态完成，继续轮询图片进度
      if (textDone && !imageDoneOrNotNeeded) {
        setQuestionGenStatus(index, 'completed', storyId, imageStatus, imageProgress)
        genQuestionPollTimers[qid] = setTimeout(() => pollQuestionGenerateStatus(index), GEN_QUESTION_POLL_INTERVAL)
        return
      }
      // 文本与配图都完成（或无需配图）时结束轮询
      if (textDone && imageDoneOrNotNeeded) {
        setQuestionGenStatus(index, 'completed', storyId, imageStatus ?? 'completed', imageProgress ?? 100)
        delete genQuestionPollTimers[qid]
        uni.showToast({ title: '生成完成', icon: 'success' })
        return
      }
      // 文本仍在生成：仅更新当前状态与图片进度
      setQuestionGenStatus(index, status, undefined, imageStatus, imageProgress)
      genQuestionPollTimers[qid] = setTimeout(() => pollQuestionGenerateStatus(index), GEN_QUESTION_POLL_INTERVAL)
    })
    .catch(() => {
      genQuestionPollTimers[qid] = setTimeout(() => pollQuestionGenerateStatus(index), GEN_QUESTION_POLL_INTERVAL)
    })
}

function goToQuestionLearning(storyId: string, questionIndex?: number, qid?: string) {
  if (assignment.value?.id) {
    let params = `storyId=${storyId}&assignmentId=${assignment.value.id}`
    if (questionIndex != null) params += `&questionIndex=${questionIndex}`
    if (qid != null && String(qid) !== '') params += `&questionId=${String(qid)}`
    uni.navigateTo({
      url: `/pages/learning/story?${params}`
    })
  }
}

function goToPrint() {
  const gc = assignment.value?.generatedContent
  const sid = (gc as any)?.storyId ?? (gc as any)?.story_id
  if (sid && assignment.value) {
    uni.navigateTo({
      url: `/pages/print/preview?storyId=${sid}&assignmentId=${assignment.value.id}`
    })
  }
}

function goToAnswer() {
  const a = assignment.value
  if (!a?.id) return
  const gc: any = a.generatedContent ?? (a as any).generated_content
  const sid = gc?.storyId ?? gc?.story_id
  const url = sid
    ? `/pages/learning/answer?assignmentId=${a.id}&storyId=${sid}`
    : `/pages/learning/answer?assignmentId=${a.id}`
  uni.navigateTo({ url })
}
</script>

<style scoped lang="scss">
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}

.content {
  padding: 32rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #f0f0f0;
  color: #666;
}

.status.completed {
  background: #d4edda;
  color: #155724;
}

.status.processing {
  background: #fff3cd;
  color: #856404;
}

.status.failed {
  background: #f8d7da;
  color: #721c24;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.edit-btn {
  padding: 8rpx 24rpx;
  background: #667eea;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
}

.image-scroll {
  white-space: nowrap;
}

.preview-image {
  width: 400rpx;
  margin-right: 24rpx;
  border-radius: 12rpx;
}

.question-item {
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.question-number {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
}

.question-type {
  padding: 4rpx 16rpx;
  background: #e8f4fd;
  color: #667eea;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.question-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.question-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.question-action-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
}

.question-action-btn.generate-btn {
  background: #e8f5e9;
  color: #2e7d32;
}

.question-action-btn.generate-btn[disabled] {
  background: #e0e0e0;
