<template>
  <view class="container">
    <view v-if="loading" class="loading">
      <text>加载中...</text>
    </view>
    
    <view v-else-if="guide" class="content">
      <view class="header">
        <text class="title">{{ guide.title || '解题引导' }}</text>
      </view>

      <scroll-view scroll-y class="guide-content">
        <view class="story-section">
          <text class="section-title">故事化解题思路</text>
          <text class="story-text">{{ guide.story }}</text>
        </view>

        <view class="steps-section">
          <text class="section-title">解题步骤</text>
          <view
            v-for="(step, index) in guide.steps"
            :key="index"
            class="step-item"
          >
            <view class="step-number">{{ index + 1 }}</view>
            <view class="step-content">
              <text class="step-title">{{ step.title }}</text>
              <text class="step-description">{{ step.description }}</text>
            </view>
          </view>
        </view>

        <view v-if="guide.knowledgePoints" class="knowledge-section">
          <text class="section-title">知识点讲解</text>
          <view
            v-for="kp in guide.knowledgePoints"
            :key="kp.topic"
            class="knowledge-item"
          >
            <text class="knowledge-topic">{{ kp.topic }}</text>
            <text class="knowledge-desc">{{ kp.description }}</text>
          </view>
        </view>

        <view v-if="guide.similarQuestions" class="similar-section">
          <text class="section-title">相似题目推荐</text>
          <view
            v-for="(question, index) in guide.similarQuestions"
            :key="index"
            class="similar-item"
            @click="goToQuestion(question.id)"
          >
            <text class="similar-text">{{ question.text }}</text>
            <text class="similar-arrow">›</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { fetchAssignmentDetail } from '@/api/assignment'
import type { AssignmentDetail } from '@/api/assignment'

interface Guide {
  title: string
  story: string
  steps: Array<{ title: string; description: string }>
  knowledgePoints?: Array<{ topic: string; description: string }>
  similarQuestions?: Array<{ id: string; text: string }>
}

const guide = ref<Guide | null>(null)
const loading = ref(true)
const questionId = ref('')

onMounted(() => {
  loadGuide()
})

function loadGuide() {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = currentPage.options || {}
  const assignmentId = parseInt(options.assignmentId || '0')
  questionId.value = options.questionId || ''
  
  if (!assignmentId) {
    uni.showToast({
      title: '作业ID无效',
      icon: 'none'
    })
    setTimeout(() => {
      uni.navigateBack()
    }, 1500)
    return
  }
  
  loading.value = true
  
  // TODO: 调用实际的解题引导 API
  // fetchGuide(assignmentId, questionId.value)
  
  // 使用 mock 数据
  setTimeout(() => {
    guide.value = {
      title: '解题引导',
      story: '小明遇到了一个有趣的数学问题。让我们一起来帮助他解决这个问题吧！',
      steps: [
        {
          title: '理解题意',
          description: '仔细阅读题目，理解题目要求我们做什么。'
        },
        {
          title: '分析条件',
          description: '找出题目中给出的已知条件和需要求解的问题。'
        },
        {
          title: '制定方案',
          description: '根据已知条件，制定解题方案。'
        },
        {
          title: '执行计算',
          description: '按照方案进行计算，得出答案。'
        },
        {
          title: '验证答案',
          description: '检查答案是否合理，是否符合题目要求。'
        }
      ],
      knowledgePoints: [
        {
          topic: '加法运算',
          description: '加法是将两个或多个数相加得到和的运算。'
        }
      ],
      similarQuestions: [
        {
          id: '1',
          text: '类似的加法题目'
        }
      ]
    }
    loading.value = false
  }, 500)
}

function goToQuestion(id: string) {
  uni.showToast({
    title: '跳转功能开发中',
    icon: 'none'
  })
}
</script>

