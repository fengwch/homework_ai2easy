  font-size: 26rpx;
  font-weight: 600;
}

.subject-badge.math { background: #eef2ff; }
.subject-badge.math .subject-text { color: #4f46e5; }
.subject-badge.chinese { background: #fff1f2; }
.subject-badge.chinese .subject-text { color: #be123c; }
.subject-badge.english { background: #ecfeff; }
.subject-badge.english .subject-text { color: #0e7490; }
.subject-badge.science { background: #ecfdf5; }
.subject-badge.science .subject-text { color: #047857; }
