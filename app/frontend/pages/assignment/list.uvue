  padding: 10rpx 20rpx;
  background: #eef1ff;
  border-radius: 999rpx;
}

.count-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #4c51bf;
}

.filters {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

/* 外层 view 承担 flex 份额，picker 作为 flex 子项撑满，保证两列严格并排 */
.filter-item {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.filter-picker {
  width: 100%;
}

.filter-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 12rpx 24rpx;
  background: #f7f8ff;
  border: 2rpx solid #e4e8ff;
  border-radius: 14rpx;
}

.filter-btn.active {
  background: #eef1ff;
  border-color: #5a67d8;
}

.filter-text {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
  min-width: 0;
}

.filter-label {
  font-size: 26rpx;
  color: #5b6270;
}

.filter-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #2f3440;
}

.filter-btn.active .filter-value {
  color: #4c51bf;
}

.chevron {
  width: 14rpx;
  height: 14rpx;
  margin-top: -8rpx;
  margin-right: 4rpx;
  border-right: 3rpx solid #8a90a6;
  border-bottom: 3rpx solid #8a90a6;
  transform: rotate(45deg);
}

.active-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.active-text {
  font-size: 26rpx;
  color: #5a67d8;
}

.reset-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  background: #eef1ff;
  border-radius: 999rpx;
}

.reset-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #4c51bf;
}

/* ---------- 列表与卡片 ---------- */

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 32rpx 40rpx;
}

.card {
  padding: 28rpx;
  background: #fff;
  border: 2rpx solid #eceef4;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 41, 55, 0.04);
}

.card-pressed {
  background: #fbfbff;
}

.card-head {
  display: flex;
  flex-direction: row;
