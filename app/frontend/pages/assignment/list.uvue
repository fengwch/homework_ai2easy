  border-radius: 5rpx;
}

.status-text {
  font-size: 24rpx;
  font-weight: 600;
}

.status-chip.pending { background: #fff4e5; }
.status-chip.pending .status-dot,
.status-chip.pending .status-text { color: #9a4a00; }
