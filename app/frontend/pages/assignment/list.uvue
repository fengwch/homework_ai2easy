<template>
  <view class="container">
    <view class="header">
      <view class="head-row">
        <text class="page-sub">{{ pageSubtitle }}</text>
        <view class="count-pill">
          <text class="count-text">{{ loading ? '—' : total + ' 份' }}</text>
        </view>
      </view>

      <!-- 两个筛选器等宽并排：外层 view 负责 flex 分配，picker 撑满 -->
      <view class="filters">
        <view class="filter-item">
          <picker class="filter-picker" :value="statusIndex" :range="statusOptions" @change="onStatusChange">
            <view class="filter-btn" :class="{ active: statusIndex > 0 }">
              <view class="filter-text">
                <text class="filter-label">状态</text>
                <text class="filter-value">{{ statusOptions[statusIndex] }}</text>
              </view>
              <view class="chevron" />
            </view>
          </picker>
        </view>
        <view class="filter-item">
          <picker class="filter-picker" :value="subjectIndex" :range="subjectOptions" @change="onSubjectChange">
            <view class="filter-btn" :class="{ active: subjectIndex > 0 }">
              <view class="filter-text">
                <text class="filter-label">科目</text>
                <text class="filter-value">{{ subjectOptions[subjectIndex] }}</text>
              </view>
              <view class="chevron" />
            </view>
          </picker>
        </view>
      </view>

      <view v-if="hasActiveFilter && !loading && !loadError" class="active-bar">
        <text class="active-text">筛选结果 {{ total }} 份</text>
        <view class="reset-chip" @click="resetFilters">
          <text class="reset-text">清除筛选</text>
        </view>
      </view>
    </view>

    <!-- 加载：骨架卡，避免整页文字闪烁 -->
    <view v-if="loading" class="list">
      <view v-for="i in 3" :key="'skel' + i" class="skeleton-card">
        <view class="skeleton-head">
          <view class="skeleton-chip" />
          <view class="skeleton-chip small" />
        </view>
        <view class="skeleton-line w70" />
        <view class="skeleton-line w40" />
        <view class="skeleton-actions">
          <view class="skeleton-btn" />
          <view class="skeleton-btn" />
        </view>
      </view>
    </view>

    <view v-else-if="loadError" class="state">
      <view class="error-icon">
        <text class="error-mark">!</text>
      </view>
      <text class="state-title">加载失败</text>
      <text class="state-hint">网络开小差了，请稍后重试</text>
      <button class="state-btn" @click="loadList()">重新加载</button>
    </view>

    <view v-else-if="list.length === 0" class="state">
      <view class="empty-icon">
        <view class="empty-line" />
        <view class="empty-line" />
        <view class="empty-line short" />
      </view>
      <text class="state-title">{{ hasActiveFilter ? '没有符合条件的作业' : '还没有作业记录' }}</text>
      <text class="state-hint">{{ hasActiveFilter ? '换个状态或科目再看看' : '拍下孩子的作业，开始 AI 辅导' }}</text>
      <button v-if="hasActiveFilter" class="state-btn ghost" @click="resetFilters">清除筛选</button>
      <button v-else class="state-btn" @click="goToScan">扫描第一份作业</button>
    </view>

    <view v-else class="list">
      <view
        v-for="item in list"
        :key="item.id"
        class="card"
        hover-class="card-pressed"
        @click="goToDetail(item.id)"
      >
        <view class="card-head">
          <view class="subject-badge" :class="subjectClass(item.subject)">
            <text class="subject-text">{{ item.subject || '作业' }}</text>
          </view>
          <view class="status-chip" :class="getDisplayStatusClass(item)">
            <view class="status-dot" />
            <text class="status-text">{{ getDisplayStatusText(item) }}</text>
          </view>
        </view>

        <text v-if="getItemTitle(item)" class="card-title">{{ getItemTitle(item) }}</text>

        <view class="card-meta">
          <text class="meta-date">{{ formatDate(item.created_at || item.createdAt) }}</text>
          <text v-if="hasScore(item)" class="score-text">{{ item.score }} 分</text>
        </view>

        <view class="card-actions">
          <button class="action-btn primary" @click.stop="goToDetail(item.id)">{{ detailLabel(item) }}</button>
          <button
            v-if="canDo(item)"
            class="action-btn"
            @click.stop="goToAnswer(item.id)"
          >
            做题
          </button>
          <button
            v-if="canReview(item)"
            class="action-btn review"
            @click.stop="goToReview(item.id)"
          >
            批改
          </button>
        </view>
      </view>

      <view class="list-footer">
        <text v-if="loadingMore" class="footer-text">加载中…</text>
        <text v-else-if="list.length >= total" class="footer-text">没有更多了</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue'
import { onPullDownRefresh, onReachBottom } from '@dcloudio/uni-app'
import { useUserStore } from '@/stores/user'
import { ensureLoggedInThen } from '@/utils/auth'
import { fetchAssignmentList } from '@/api/assignment'

const userStore = useUserStore()
const list = ref<any[]>([])
const loading = ref(true)
const loadingMore = ref(false)
const refreshing = ref(false)
const loadError = ref(false)
const total = ref(0)
const page = ref(1)
const pageSize = 20
const statusIndex = ref(0)
const subjectIndex = ref(0)

// 防止快速切换筛选时旧请求覆盖新结果
let requestSeq = 0

const statusOptions = ['全部', '待处理', '处理中', '未作答', '已作答', '失败']
const statusMap: Record<string, string> = {
  '全部': '',
  '待处理': 'pending',
  '处理中': 'processing',
  '未作答': 'completed',
  '已作答': 'completed',
  '失败': 'failed'
}
const statusFilterHasAnswers: Record<string, boolean | undefined> = {
  '全部': undefined,
  '待处理': undefined,
  '处理中': undefined,
  '未作答': false,
  '已作答': true,
  '失败': undefined
}
const subjectOptions = ['全部', '数学', '语文', '英语', '科学', '其他']

const hasActiveFilter = computed(() => statusIndex.value > 0 || subjectIndex.value > 0)
const currentChildName = computed(() => {
  const current = userStore.children.value.find(
    (c) => String(c.id) === String(userStore.currentChildId.value)
  )
  return current?.name || ''
})
const pageSubtitle = computed(() => currentChildName.value
  ? currentChildName.value + '的作业 · 按时间倒序'
  : '按时间倒序排列')

onMounted(() => {
  ensureLoggedInThen(() => {
    loadList()
  })
})

onPullDownRefresh(() => {
  if (loading.value || loadingMore.value || refreshing.value) {
    uni.stopPullDownRefresh()
    return
  }
  // 静默刷新：保留现有列表，由原生下拉指示器承担加载反馈，避免骨架屏闪烁
  refreshing.value = true
  loadList(true, true).finally(() => {
    refreshing.value = false
    uni.stopPullDownRefresh()
  })
})

onReachBottom(() => {
  loadMore()
})

function loadList(reset = true, silent = false) {
  if (reset) {
    page.value = 1
    if (!silent) {
      list.value = []
      loadError.value = false
      loading.value = true
    }
  } else {
    loadingMore.value = true
  }

  const seq = ++requestSeq
  const params: any = {
    page: page.value,
    page_size: pageSize
  }
  const status = statusMap[statusOptions[statusIndex.value]]
  if (status) params.status = status
  const hasAnswers = statusFilterHasAnswers[statusOptions[statusIndex.value]]
  if (hasAnswers !== undefined && status === 'completed') params.has_answers = hasAnswers
  const subject = subjectIndex.value > 0 ? subjectOptions[subjectIndex.value] : undefined
  if (subject) params.subject = subject
  if (userStore.currentChildId.value) params.child_id = userStore.currentChildId.value

  return fetchAssignmentList(params)
    .then((data: any) => {
      if (seq !== requestSeq) return
      const items = data.list || []
      total.value = data.total ?? 0
      if (reset) {
        loadError.value = false
        list.value = items
      } else {
        list.value = list.value.concat(items)
      }
    })
    .catch((err) => {
      if (seq !== requestSeq) return
      console.error('加载作业列表失败:', err)
      if (reset) {
        if (silent) {
          uni.showToast({ title: '刷新失败，请稍后重试', icon: 'none' })
        } else {
          loadError.value = true
          list.value = []
        }
      } else {
        page.value = Math.max(1, page.value - 1)
        uni.showToast({ title: '加载失败，请重试', icon: 'none' })
      }
    })
    .finally(() => {
      if (seq !== requestSeq) return
      loading.value = false
      loadingMore.value = false
    })
}

function onStatusChange(e: any) {
  statusIndex.value = e.detail.value
  loadList()
}

function onSubjectChange(e: any) {
  subjectIndex.value = e.detail.value
  loadList()
}

function resetFilters() {
  if (!hasActiveFilter.value) return
  statusIndex.value = 0
  subjectIndex.value = 0
  loadList()
}

function loadMore() {
  if (loading.value || loadingMore.value || refreshing.value) return
  if (list.value.length >= total.value) return
  page.value++
  loadList(false)
}

function resolveHasAnswers(item: any): boolean {
  if (item.has_answers === true || item.hasAnswers === true) return true
  if (item.has_answers === false || item.hasAnswers === false) return false
  if (item.answered === true) return true
  return false
}

function getDisplayStatusText(item: any): string {
  const s = item.status
  if (s === 'pending') return '待处理'
  if (s === 'processing') return '处理中'
  if (s === 'failed') return '失败'
  if (s === 'completed') {
    return resolveHasAnswers(item) ? '已作答' : '未作答'
  }
  return s || ''
}

function getDisplayStatusClass(item: any): string {
  const s = item.status
  if (s === 'completed') {
    return resolveHasAnswers(item) ? 'answered' : 'unanswered'
  }
  if (s === 'pending' || s === 'processing' || s === 'failed') return s
  return 'unknown'
}

function subjectClass(subject: string): string {
  if (subject === '数学') return 'math'
  if (subject === '语文') return 'chinese'
  if (subject === '英语') return 'english'
  if (subject === '科学') return 'science'
  return 'default'
}

function getItemTitle(item: any): string {
  if (item.title) return item.title
  if (item.name) return item.name
  return ''
}

function hasScore(item: any): boolean {
  return item.score !== null && item.score !== undefined && item.score !== ''
}

function detailLabel(item: any): string {
  return item.status === 'completed' ? '查看辅导' : '查看详情'
}

function formatDate(str: string): string {
  if (!str) return ''
  const normalized = str.indexOf('T') >= 0 ? str : str.replace(' ', 'T')
  const d = new Date(normalized)
  if (isNaN(d.getTime())) return str

  const now = new Date()
  const hours = String(d.getHours()).padStart(2, '0')
  const minutes = String(d.getMinutes()).padStart(2, '0')
  const time = hours + ':' + minutes

  const sameDay = d.getFullYear() === now.getFullYear()
    && d.getMonth() === now.getMonth()
    && d.getDate() === now.getDate()
  if (sameDay) return '今天 ' + time

  const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1)
  const isYesterday = d.getFullYear() === yesterday.getFullYear()
    && d.getMonth() === yesterday.getMonth()
    && d.getDate() === yesterday.getDate()
  if (isYesterday) return '昨天 ' + time

  const month = d.getMonth() + 1
  const day = d.getDate()
  if (d.getFullYear() === now.getFullYear()) {
    return month + '月' + day + '日 ' + time
  }
  return d.getFullYear() + '年' + month + '月' + day + '日'
}

function canDo(item: any) {
  return item.status === 'completed'
}

function canReview(item: any) {
  if (item.status !== 'completed') return false
  return resolveHasAnswers(item)
}

function goToDetail(id: number) {
  uni.navigateTo({ url: `/pages/assignment/detail?id=${id}` })
}

function goToAnswer(id: number) {
  uni.navigateTo({ url: `/pages/learning/answer?assignmentId=${id}` })
}

function goToReview(id: number) {
  uni.navigateTo({ url: `/pages/assignment/review?assignmentId=${id}` })
}

function goToScan() {
  if (!userStore.currentChildId.value) {
    uni.showToast({ title: '请先在首页选择孩子', icon: 'none' })
    return
  }
  uni.navigateTo({ url: '/pages/assignment/scan' })
}

</script>

<style scoped lang="scss">
