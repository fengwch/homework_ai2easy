.status-chip.answered { background: #e9f9f0; }
.status-chip.answered .status-dot,
.status-chip.answered .status-text { color: #0f6b4f; }
.status-chip.answered .status-dot { background: #059669; }

.status-chip.failed { background: #fdecec; }
.status-chip.failed .status-dot,
.status-chip.failed .status-text { color: #b42318; }
.status-chip.failed .status-dot { background: #dc2626; }

.status-chip.unknown { background: #f3f4f6; }
.status-chip.unknown .status-dot,
.status-chip.unknown .status-text { color: #4b5563; }
.status-chip.unknown .status-dot { background: #6b7280; }

.card-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #2f3440;
}

.card-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
