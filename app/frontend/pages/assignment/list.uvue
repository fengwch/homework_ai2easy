}

.card-actions {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f2f4f8;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  background: #f1f3f7;
  color: #4b5563;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  background: #5a67d8;
  color: #fff;
  font-weight: 600;
}

.action-btn.review {
  background: #e9f7f0;
  color: #0f6b4f;
  font-weight: 600;
}

/* ---------- 加载 / 空 / 错误 ---------- */

.skeleton-card {
  padding: 28rpx;
  background: #fff;
  border: 2rpx solid #eef0f4;
  border-radius: 18rpx;
}

.skeleton-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.skeleton-chip {
  width: 104rpx;
  height: 36rpx;
  background: #eef0f5;
  border-radius: 10rpx;
}

.skeleton-chip.small {
  width: 80rpx;
  border-radius: 18rpx;
}

.skeleton-line {
  height: 24rpx;
  margin-top: 20rpx;
  background: #eef0f5;
  border-radius: 8rpx;
}

.skeleton-line.w70 {
  width: 70%;
}

.skeleton-line.w40 {
  width: 40%;
}

.skeleton-actions {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  margin-top: 28rpx;
}

.skeleton-btn {
  flex: 1;
  height: 72rpx;
  background: #f1f2f6;
  border-radius: 12rpx;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 14rpx;
  width: 132rpx;
  height: 156rpx;
  padding: 32rpx 24rpx;
  background: #f7f8ff;
  border: 4rpx solid #c9d0ff;
  border-radius: 20rpx;
}

.empty-line {
  height: 6rpx;
  background: #c9d0ff;
  border-radius: 3rpx;
}

.empty-line.short {
  width: 60%;
}

.error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  background: #fdecec;
  border-radius: 60rpx;
}

.error-mark {
  font-size: 56rpx;
  font-weight: bold;
  color: #b42318;
}

.state-title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #2f3440;
}

.state-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5b6270;
  text-align: center;
}

.state-btn {
  min-width: 280rpx;
  height: 88rpx;
  line-height: 88rpx;
