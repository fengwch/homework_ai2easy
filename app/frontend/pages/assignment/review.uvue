<template>
  <view class="container">
    <view v-if="loading" class="loading">
      <text>加载中...</text>
    </view>

    <view v-else class="content">
      <view class="summary-card">
        <text class="summary-title">答题结果</text>
        <view class="summary-row">
          <view class="summary-item">
            <text class="num">{{ correctCount }}+{{ wrongCount }}</text>
            <text class="label">正确/错误</text>
          </view>
          <view class="summary-item">
            <text class="num">{{ correctRate }}%</text>
            <text class="label">正确率</text>
          </view>
          <view v-if="score != null" class="summary-item">
            <text class="num">{{ score }}分</text>
            <text class="label">得分</text>
          </view>
        </view>
        <text v-if="score == null && hasAnyAnswered" class="summary-hint">无标准答案的题目不参与计分</text>
      </view>

      <view class="questions-section">
        <text class="section-title">题目详情</text>
        <view
          v-for="(item, index) in results"
          :key="index"
          class="question-card"
          :class="{ wrong: item.hasStandardAnswer && item.isCorrect === false }"
        >
          <view class="q-header">
            <text class="q-num">第{{ index + 1 }}题</text>
            <text v-if="item.hasStandardAnswer" class="q-result" :class="item.isCorrect ? 'correct' : 'wrong'">
              {{ item.isCorrect ? '✓ 正确' : '✗ 错误' }}
            </text>
            <text v-else class="q-result neutral">已作答</text>
          </view>
          <text class="q-content">{{ item.questionText }}</text>
          <view class="q-answer">
            <text class="label">小孩作答：</text>
            <text :class="{ wrong: item.hasStandardAnswer && item.isCorrect === false }">{{ item.userAnswer || '（未作答）' }}</text>
          </view>
          <view v-if="item.hasStandardAnswer && item.isCorrect === false && item.correctAnswer" class="q-correct">
            <text class="label">正确答案：</text>
            <text>{{ item.correctAnswer }}</text>
          </view>
          <view v-if="item.analysis" class="q-analysis">
            <text class="label">解析：</text>
            <text>{{ item.analysis }}</text>
          </view>
          <button
            v-if="item.hasStandardAnswer && item.isCorrect === false"
            class="guide-btn"
            @click="goToGuide(item.questionId)"
          >
            查看解题引导
          </button>
        </view>
      </view>

      <view class="footer">
        <button class="primary-btn" @click="goBack">返回</button>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue'
import { fetchAssignmentAnswers } from '@/api/content'
import { fetchAssignmentDetail } from '@/api/assignment'
import type { Question } from '@/api/assignment'

interface ReviewItem {
  questionId: string
  questionText: string
  userAnswer: string
  correctAnswer?: string | null
  analysis?: string | null
  isCorrect?: boolean | null
  hasStandardAnswer: boolean
}

const results = ref<ReviewItem[]>([])
const loading = ref(true)
const assignmentId = ref(0)
const score = ref<number | null>(null)

const correctCount = computed(() => results.value.filter(r => r.hasStandardAnswer && r.isCorrect === true).length)
const wrongCount = computed(() => results.value.filter(r => r.hasStandardAnswer && r.isCorrect === false).length)
const correctRate = computed(() => {
  const n = results.value.filter(r => r.hasStandardAnswer).length
  return n > 0 ? Math.round((correctCount.value / n) * 100) : 0
})
const hasAnyAnswered = computed(() => results.value.some(r => (r.userAnswer || '').trim() !== ''))

onMounted(() => {
  loadData()
})

function loadData() {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = currentPage.options || {}
  const id = parseInt(options.assignmentId || options.id || '0')
  
  if (!id) {
    uni.showToast({ title: '参数无效', icon: 'none' })
    loading.value = false
    return
  }
  
  assignmentId.value = id
  
  fetchAssignmentAnswers(id)
    .then((data) => {
      results.value = data.questions.map((q) => ({
        questionId: q.questionId,
        questionText: q.questionText,
        userAnswer: q.userAnswer,
        correctAnswer: q.correctAnswer,
        analysis: q.analysis,
        isCorrect: q.isCorrect ?? null,
        hasStandardAnswer: q.hasStandardAnswer
      }))
      score.value = data.score ?? null
    })
    .catch(async () => {
      await loadFallbackFromDetail(id)
    })
    .finally(() => {
      loading.value = false
    })
}

function loadFallbackFromDetail(id: number): Promise<void> {
  return fetchAssignmentDetail(id)
    .then((data) => {
      const qs = data.questions || []
      results.value = qs.map((q: Question) => {
        const hasAnswer = !!(q.structuredData?.answer)
        return {
          questionId: q.id,
          questionText: (q as any).original_text ?? q.originalText ?? '',
          userAnswer: '（暂未保存作答，仅展示题目）',
          correctAnswer: hasAnswer ? q.structuredData?.answer : null,
          analysis: q.structuredData?.analysis ?? null,
          isCorrect: null as boolean | null,
          hasStandardAnswer: hasAnswer
        }
      })
      score.value = null
    })
    .catch(() => {
      results.value = []
    })
}

function goToGuide(questionId: string) {
  uni.navigateTo({
    url: `/pages/assignment/guide?assignmentId=${assignmentId.value}&questionId=${questionId}`
  })
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped lang="scss">
