  display: flex;
  flex-direction: column;
}

.num {
  font-size: 48rpx;
  font-weight: bold;
}

.label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.questions-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #4cd964;
}

.question-card.wrong {
  border-left-color: #f56c6c;
}

.q-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.q-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
}

.q-result {
  font-size: 26rpx;
}

.q-result.correct { color: #4cd964; }
.q-result.wrong { color: #f56c6c; }
.q-result.neutral { color: #999; }

.q-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.q-answer, .q-correct, .q-analysis {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.q-answer .wrong, .q-result.wrong {
  color: #f56c6c;
}

.label {
  color: #999;
  margin-right: 8rpx;
}

.guide-btn {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff3cd;
  color: #856404;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 2rpx solid #f5f5f5;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}
</style>
