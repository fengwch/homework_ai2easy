  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
  color: #fff;
}

.summary-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 24rpx;
}

.summary-row {
  display: flex;
  gap: 48rpx;
  flex-wrap: wrap;
}

.summary-hint {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 16rpx;
  display: block;
}

