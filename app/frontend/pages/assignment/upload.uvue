<template>
  <view class="container">
    <view class="tip">
      为
      <text class="highlight">{{ currentChildName || '未选择的孩子' }}</text>
      上传作业照片
    </view>

    <view class="card" @click="onChooseImage" role="button" aria-label="点击拍照或从相册选择">
      <view v-if="!imagePath" class="placeholder">
        <text class="icon">📷</text>
        <text>点击拍照或从相册选择</text>
      </view>
      <image v-else :src="imagePath" mode="widthFix" class="preview" />
    </view>

    <button
      class="primary-btn"
      :disabled="!imagePath || uploading"
      @click="onUpload"
      aria-label="确认上传"
    >
      {{ uploading ? '上传中...' : '确认上传' }}
    </button>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { useUserStore } from '@/stores/user'
import { useAssignmentStore } from '@/stores/assignment'
import { ensureLoggedInThen } from '@/utils/auth'

const userStore = useUserStore()
const assignmentStore = useAssignmentStore()

const imagePath = ref<string | null>(null)
const uploading = ref(false)

const currentChildName = computed(() => {
  const id = userStore.currentChildId.value
  const target = userStore.children.value.find((c) => c.id === id)
  return target?.name
})

onShow(() => {
  ensureLoggedInThen(() => {
    if (!userStore.currentChildId.value) {
      uni.showToast({ title: '请先选择孩子', icon: 'none' })
      uni.reLaunch({ url: '/pages/child/list' })
    }
  })
})

function onChooseImage() {
  // H5 端和小程序端都支持 uni.chooseImage
  uni.showActionSheet({
    itemList: ['拍照', '从相册选择'],
    success: (res) => {
      const sourceType = res.tapIndex === 0 ? ['camera'] : ['album']
      
      uni.chooseImage({
        count: 1,
        sizeType: ['compressed'], // 自动压缩
        sourceType,
        success: (chooseRes) => {
          const originalPath = chooseRes.tempFilePaths[0]
          
          // 小程序端可以进一步压缩
          // #ifndef H5
          uni.compressImage({
            src: originalPath,
            quality: 80,
            success: (compressRes) => {
              imagePath.value = compressRes.tempFilePath
              assignmentStore.setCurrent({
                localImagePath: imagePath.value!,
                uploading: false
              })
            },
            fail: () => {
              // 压缩失败，使用原图
              imagePath.value = originalPath
              assignmentStore.setCurrent({
                localImagePath: imagePath.value!,
                uploading: false
              })
            }
          })
          // #endif
          
          // #ifdef H5
          // H5 端已通过 sizeType: ['compressed'] 压缩，直接使用
          imagePath.value = originalPath
          assignmentStore.setCurrent({
            localImagePath: imagePath.value!,
            uploading: false
          })
          // #endif
        },
        fail: (err) => {
          console.error('选择图片失败:', err)
          uni.showToast({
            title: '选择图片失败',
            icon: 'none'
          })
        }
      })
    },
    fail: (err) => {
      console.error('显示操作菜单失败:', err)
    }
  })
}

async function onUpload() {
  if (!imagePath.value || uploading.value) return
  
  uploading.value = true
  
  try {
    // 获取 baseURL
    // #ifdef H5
    const baseUrl = import.meta.env.VITE_API_BASE_URL || import.meta.env.VUE_APP_API_BASE_URL || ''
    // #endif
    // #ifndef H5
    const baseUrl = import.meta.env.VITE_API_BASE_URL || ''
    // #endif
    
    const systemInfo = uni.getSystemInfoSync()
    const platform = systemInfo.uniPlatform || ''
    
    uni.uploadFile({
      url: baseUrl + '/api/v1/assignments/upload',
      filePath: imagePath.value!,
      name: 'file',
      formData: {
        childId: String(userStore.currentChildId.value || '')
      },
      header: {
        Authorization: userStore.token.value ? `Bearer ${userStore.token.value}` : '',
        'X-Platform': platform
      },
      success: (res) => {
        try {
          const data = JSON.parse(res.data) as { code: number; data?: any; message?: string }
          if (data.code === 0 && data.data && data.data.id) {
            const id = data.data.id as number
            uni.redirectTo({ url: `/pages/assignment/detail?id=${id}` })
          } else {
            uni.showToast({ title: data.message || '上传失败', icon: 'none' })
          }
        } catch (e) {
          console.error('解析响应失败:', e)
          uni.showToast({ title: '解析失败', icon: 'none' })
        }
      },
      fail: (err) => {
        console.error('上传失败:', err)
        // #ifdef H5
        if (err.errMsg && err.errMsg.includes('fail')) {
          uni.showToast({
            title: '上传失败，请检查网络连接或跨域配置',
            icon: 'none',
            duration: 3000
          })
        } else {
          uni.showToast({ title: '上传失败', icon: 'none' })
        }
        // #endif
        // #ifndef H5
        uni.showToast({ title: '上传失败', icon: 'none' })
        // #endif
      },
      complete: () => {
        uploading.value = false
      }
    })
  } catch (e) {
    console.error('上传异常:', e)
    uploading.value = false
    uni.showToast({ title: '上传异常', icon: 'none' })
  }
}
</script>

<style scoped lang="scss">
.container {
  padding: 32rpx;
}

.tip {
  font-size: 28rpx;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.highlight {
  color: $uni-color-primary;
}

.card {
  margin-top: 24rpx;
  border-radius: 16rpx;
  background-color: $uni-bg-color-grey;
  padding: 40rpx 24rpx;
  text-align: center;
}

.placeholder {
  color: $uni-text-color-grey;
  font-size: 26rpx;
}

.icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 12rpx;
}

.preview {
  width: 100%;
  border-radius: 12rpx;
}

.primary-btn {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background-color: $uni-color-primary;
  color: #fff;
}
</style>
