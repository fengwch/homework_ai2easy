<template>
  <view class="container">
    <view class="title">AI作业辅导</view>
    <view class="subtitle">登录/注册</view>

    <view class="form">
      <view class="input-group">
        <text class="label">手机号</text>
        <input
          v-model="phone"
          type="number"
          placeholder="请输入手机号"
          maxlength="11"
          class="input"
        />
      </view>

      <view class="input-group">
        <text class="label">验证码</text>
        <view class="code-row">
          <input
            v-model="code"
            type="number"
            placeholder="请输入验证码"
            maxlength="6"
            class="input code-input"
          />
          <button
            class="code-btn"
            :disabled="countdown > 0 || sending"
            @click="sendCode"
          >
            {{ countdown > 0 ? `${countdown}秒` : '获取验证码' }}
          </button>
        </view>
      </view>

      <!-- 使用 view+role 确保 H5 下登录按钮出现在无障碍树，便于 Browser MCP 定位 -->
      <view
        class="login-btn"
        role="button"
        :aria-disabled="(!canLogin || loading) ? 'true' : 'false'"
        aria-label="登录"
        :data-disabled="!canLogin || loading"
        @click="(!canLogin || loading) ? null : handleLogin()"
      >
        {{ loading ? '登录中...' : '登录' }}
      </view>

      <view class="agreement">
        <checkbox-group @change="onAgreementChange">
          <label
            class="agreement-item"
            role="checkbox"
            :aria-checked="agreed ? 'true' : 'false'"
            tabindex="0"
          >
            <checkbox
              class="agreement-checkbox"
              value="agree"
              :checked="agreed"
              aria-label="同意用户协议和隐私政策"
            />
            <text>我已阅读并同意《用户协议》和《隐私政策》</text>
          </label>
        </checkbox-group>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { useUserStore } from '@/stores/user'
import { sendSmsCode } from '@/api/auth'

const userStore = useUserStore()

const phone = ref('')
const code = ref('')
const countdown = ref(0)
const sending = ref(false)
const loading = ref(false)
const agreed = ref(false)

const canLogin = computed(() => {
  return phone.value.length === 11 && code.value.length === 6 && agreed.value
})

function onAgreementChange(e: any) {
  agreed.value = e.detail.value.includes('agree')
}

async function sendCode() {
  if (phone.value.length !== 11) {
    uni.showToast({
      title: '请输入正确的手机号',
      icon: 'none'
    })
    return
  }

  sending.value = true
  try {
    await sendSmsCode(phone.value, 'login')
    uni.showToast({
      title: '验证码已发送',
      icon: 'success'
    })
    
    // 开始倒计时
    countdown.value = 60
    const timer = setInterval(() => {
      countdown.value--
      if (countdown.value <= 0) {
        clearInterval(timer)
      }
    }, 1000)
  } catch (err: any) {
    console.error('发送验证码失败:', err)
    uni.showToast({
      title: err?.message || '发送失败，请重试',
      icon: 'none',
      duration: 2000
    })
  } finally {
    sending.value = false
  }
}

async function handleLogin() {
  if (!canLogin.value) return

  loading.value = true
  try {
    await userStore.login(phone.value, code.value)
    uni.showToast({
      title: '登录成功',
      icon: 'success'
    })
    
    // 跳转到儿童列表页
    setTimeout(() => {
      uni.reLaunch({ url: '/pages/child/list' })
    }, 1000)
  } catch (err: any) {
    console.error('登录失败:', err)
    uni.showToast({
      title: err?.message || '登录失败，请重试',
      icon: 'none',
      duration: 2000
    })
  } finally {
    loading.value = false
  }
}
</script>

<style scoped lang="scss">
.container {
  padding: 80rpx 60rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  margin-bottom: 80rpx;
}

.form {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.code-row {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
}

.code-btn[disabled] {
  background: #ccc;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}

.login-btn[data-disabled="true"] {
  background: #ccc;
  cursor: not-allowed;
}

.agreement {
  margin-top: 40rpx;
}

.agreement-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.agreement-checkbox {
  flex-shrink: 0;
  margin-right: 12rpx;
}
</style>
