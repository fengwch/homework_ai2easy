<template>
  <view class="container">
    <view class="title">注册账号</view>
    <view class="subtitle">创建您的账号，开始使用AI作业辅导</view>

    <view class="form">
      <view class="input-group">
        <text class="label">手机号</text>
        <input
          v-model="phone"
          type="number"
          placeholder="请输入手机号"
          maxlength="11"
          class="input"
        />
      </view>

      <view class="input-group">
        <text class="label">验证码</text>
        <view class="code-row">
          <input
            v-model="code"
            type="number"
            placeholder="请输入验证码"
            maxlength="6"
            class="input code-input"
          />
          <button
            class="code-btn"
            :disabled="countdown > 0 || sending || !canSendCode"
            @click="sendCode"
          >
            {{ countdown > 0 ? `${countdown}秒` : '获取验证码' }}
          </button>
        </view>
      </view>

      <view class="input-group">
        <text class="label">密码（可选）</text>
        <input
          v-model="password"
          type="password"
          placeholder="设置密码，用于密码登录"
          class="input"
        />
      </view>

      <button
        class="register-btn"
        :disabled="!canRegister || loading"
        @click="handleRegister"
      >
        {{ loading ? '注册中...' : '注册' }}
      </button>

      <view class="agreement">
        <checkbox-group @change="onAgreementChange">
          <label class="agreement-item">
            <checkbox class="agreement-checkbox" value="agree" :checked="agreed" />
            <text><text class="agreement-prefix">我已阅读</text>并同意《用户协议》和《隐私政策》</text>
          </label>
        </checkbox-group>
      </view>

      <view class="login-link">
        <text>已有账号？</text>
        <text class="link" @click="goToLogin">立即登录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { validatePhone, validateCode } from '@/utils/validator'
import { sendSmsCode } from '@/api/auth'

const phone = ref('')
const code = ref('')
const password = ref('')
const countdown = ref(0)
const sending = ref(false)
const loading = ref(false)
const agreed = ref(false)

const canSendCode = computed(() => {
  return validatePhone(phone.value)
})

const canRegister = computed(() => {
  return validatePhone(phone.value) && validateCode(code.value) && agreed.value
})

function onAgreementChange(e: any) {
  agreed.value = e.detail.value.includes('agree')
}

async function sendCode() {
  if (!canSendCode.value) {
    uni.showToast({
      title: '请输入正确的手机号',
      icon: 'none'
    })
    return
  }

  sending.value = true
  try {
    await sendSmsCode(phone.value)
    uni.showToast({
      title: '验证码已发送',
      icon: 'success'
    })
    
    // 开始倒计时
    countdown.value = 60
    const timer = setInterval(() => {
      countdown.value--
      if (countdown.value <= 0) {
        clearInterval(timer)
      }
    }, 1000)
  } catch (err) {
    console.error('发送验证码失败:', err)
    uni.showToast({
      title: '发送失败，请重试',
      icon: 'none'
    })
  } finally {
    sending.value = false
  }
}

async function handleRegister() {
  if (!canRegister.value) return

  loading.value = true
  try {
    // TODO: 调用注册 API
    // const res = await register(phone.value, code.value, password.value)
    
    uni.showToast({
      title: '注册成功',
      icon: 'success'
    })
    
    // 跳转到登录页
    setTimeout(() => {
      uni.redirectTo({ url: '/pages/auth/login' })
    }, 1000)
  } catch (err) {
    console.error('注册失败:', err)
    uni.showToast({
      title: '注册失败，请重试',
      icon: 'none'
    })
  } finally {
    loading.value = false
  }
}

function goToLogin() {
  uni.redirectTo({ url: '/pages/auth/login' })
}
</script>

<style scoped lang="scss">
.container {
  padding: 80rpx 60rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  margin-bottom: 80rpx;
}

.form {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.code-row {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
}

.code-btn[disabled] {
  background: #ccc;
}

.register-btn {
  width: 100%;
  height: 88rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
  border: none;
}

.register-btn[disabled] {
  background: #ccc;
}

.agreement {
  margin-top: 40rpx;
}

.agreement-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.agreement-checkbox {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.login-link {
  margin-top: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.link {
  color: #667eea;
  margin-left: 8rpx;
}
</style>
