  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 歧义项：红色高亮置顶，处理完才放行 */
.pending-card {
  background: #fff5f5;
  border: 2rpx solid #f1b0b7;
}

.pending-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #a61b29;
  margin-bottom: 16rpx;
}

.pending-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid #f8d7da;
}

.pending-text {
  font-size: 28rpx;
  color: #a61b29;
}

.pending-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.mini {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #fff;
  background: #c0392b;
  border-radius: 8rpx;
  border: none;
}

.mini.ghost {
  color: #666;
  background: #eee;
}

.reward-card {
  margin-top: -4rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.reward-input {
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.reward-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.item-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.item-seq {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #667eea;
  color: #fff;
  font-size: 24rpx;
}

.item-subject {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.drop-wrap {
  margin-left: auto;
  padding: 8rpx 0 8rpx 24rpx;
}

.drop-text {
  font-size: 24rpx;
  color: #a61b29;
}

.badge {
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #a61b29;
  background: #fde2e2;
}

.field-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.field-label {
  width: 96rpx;
  font-size: 26rpx;
  color: #666;
}

.field-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.field-picker {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  color: #333;
}

.extra-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.error {
  display: block;
  margin: 16rpx 0;
  font-size: 26rpx;
  color: #c0392b;
  white-space: pre-line;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #eee;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}

.btn.primary {
  color: #fff;
  background: #667eea;
}
</style>
