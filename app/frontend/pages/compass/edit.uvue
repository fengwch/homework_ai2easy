<template>
  <view class="page">
    <view class="preview-card">
      <image v-if="previewUrl" :src="previewUrl" class="preview" mode="aspectFit" @click="goDownload" />
      <view v-else class="preview placeholder">
        <text class="placeholder-text">点击下方按钮生成预览</text>
      </view>
    </view>

    <view class="card">
      <text class="label">标题</text>
      <input v-model="slogan" class="field" :placeholder="defaultSlogan()" @blur="onSloganBlur" />
      <text class="hint">显示在目标图顶部，例如「小宇的闯关地图」；改完会自动重新生成</text>
    </view>

    <view class="card">
      <text class="label">配色</text>
      <picker :range="skinNames" :value="skinIndex" @change="onSkinChange">
        <view class="field picker-field">当前：{{ skinNames[skinIndex] }}</view>
      </picker>
    </view>

    <text v-if="usedPlaceholder" class="hint block">当前为占位底图，仅用于核对排版</text>
    <text v-for="(issue, i) in issues" :key="i" class="error">[{{ issue.zone }}] {{ issue.text }}：{{ issue.reason }}</text>
    <text v-if="errorText" class="error">{{ errorText }}</text>

    <view class="footer">
      <button class="btn ghost" :disabled="working" @click="rerender">
        {{ working ? '生成中...' : '重新生成' }}
      </button>
      <button class="btn primary" :disabled="working || !previewUrl" @click="goDownload">完成，去下载</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { COMPASS_SKINS, COMPASS_SKIN_NAMES, compassImageUrl, compassPatch, compassRender } from '@/api/compass'
import { useCompassStore } from '@/stores/compass'

const store = useCompassStore()
const skinNames: string[] = COMPASS_SKIN_NAMES
const skinIndex = ref(0)
const slogan = ref('')
const previewUrl = ref('')
const usedPlaceholder = ref(false)
const issues = ref<Array<{ zone: string; text: string; reason: string }>>([])
const working = ref(false)
const errorText = ref('')

onLoad(() => {
  const hw = store.state.hw
  if (!hw) {
    uni.redirectTo({ url: '/pages/compass/input' })
    return
  }
  // 标题默认按当前孩子生成「XX 的今日目标」；家长改过（hw.slogan 非空）就用他的
  slogan.value = hw.slogan || defaultSlogan()
  skinIndex.value = Math.max(0, COMPASS_SKINS.indexOf(store.state.skin))
  showRender()
  // 默认标题要真正落进 hw 并重出图，否则图上仍是「日期 · 姓名 · 今日目标」
  if (!hw.slogan) {
    applySlogan()
  }
})

// 默认标题：有孩子姓名就「XX 的今日目标」，否则退回通用文案
function defaultSlogan(): string {
  const name = (store.state.childName || '').trim()
  return name ? `${name}的今日目标` : '今日目标'
}

// 每次出图 URL 相同，<image> 会命中缓存不刷新；拼上时间戳强制重新拉取
let stamp = 0
function showRender() {
  const r = store.state.render
  stamp += 1
  previewUrl.value = r ? `${compassImageUrl(r.url)}?t=${stamp}` : ''
  usedPlaceholder.value = r ? r.used_placeholder : false
  issues.value = r ? r.issues : []
}

async function applySlogan() {
  const hw = store.state.hw
  if (!hw) return
  await run(async () => {
    store.setHomework(await compassPatch(hw, { slogan: slogan.value }))
    store.setRender(await compassRender(store.state.hw!, 'quest-map', COMPASS_SKINS[skinIndex.value]))
    showRender()
  })
}

async function onSloganBlur() {
  const hw = store.state.hw
  if (!hw || slogan.value === (hw.slogan || '')) return
  await applySlogan()
}

function onSkinChange(e: any) {
  skinIndex.value = Number(e?.detail?.value || 0)
  store.setSkin(COMPASS_SKINS[skinIndex.value])
  rerender()
}

async function rerender() {
  const hw = store.state.hw
  if (!hw) return
  await run(async () => {
    store.setRender(await compassRender(hw, 'quest-map', COMPASS_SKINS[skinIndex.value]))
    showRender()
  })
}

function goDownload() {
  if (!store.state.render) return
  uni.navigateTo({ url: '/pages/compass/download' })
}

async function run(task: () => Promise<void>) {
  working.value = true
  errorText.value = ''
  try {
    await task()
  } catch (err: any) {
    errorText.value = err?.message || '请求失败'
  } finally {
    working.value = false
  }
}
</script>

<style scoped lang="scss">
.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 200rpx;
  background: #f5f5f5;
}

.preview-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
}

.preview {
  width: 100%;
  height: 900rpx;
  background: #fafafa;
  border-radius: 8rpx;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 26rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.field {
  height: 88rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.picker-field {
  line-height: 88rpx;
  color: #333;
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.hint.block {
  margin-bottom: 16rpx;
}

.error {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #c0392b;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #eee;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}

.btn.primary {
  color: #fff;
  background: #667eea;
}

.btn.ghost {
  color: #667eea;
  background: #f4f5ff;
}
</style>
