<template>
  <view class="container">
    <view v-if="loading" class="loading">
      <text>加载中...</text>
    </view>
    
    <view v-else-if="generating" class="generating">
      <view class="progress-ring">
        <text class="progress-text">{{ progress }}%</text>
      </view>
      <text class="generating-title">正在生成个性化学习内容</text>
      <text class="generating-hint">预计需要 30 秒，请耐心等待</text>
    </view>
    
    <view v-else-if="content" class="preview-content">
      <view class="header">
        <text class="title">{{ content.title }}</text>
        <text v-if="content.summary" class="summary">{{ content.summary }}</text>
      </view>
      <scroll-view scroll-y class="body">
        <text class="story-text">{{ content.story }}</text>
        <view v-if="content.questions?.length" class="questions-info">
          <text>包含 {{ content.questions.length }} 道练习题</text>
        </view>
      </scroll-view>
      <view class="footer">
        <button class="primary-btn" @click="goToStory">开始学习</button>
        <button class="secondary-btn" @click="handleRegenerate">重新生成</button>
      </view>
    </view>

    <view v-else class="empty">
      <text>暂无内容</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { fetchLearningContent } from '@/api/content'
import { generateContent } from '@/api/assignment'
import type { LearningContent } from '@/api/content'

const content = ref<LearningContent | null>(null)
const loading = ref(true)
const generating = ref(false)
const progress = ref(0)
const storyId = ref('')
const assignmentId = ref(0)

onMounted(() => {
  loadData()
})

function loadData() {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = currentPage.options || {}
  const sid = options.storyId || options.id || ''
  const aid = parseInt(options.assignmentId || '0')
  
  if (!sid) {
    uni.showToast({ title: '参数无效', icon: 'none' })
    loading.value = false
    return
  }
  
  storyId.value = sid
  assignmentId.value = aid
  loading.value = true
  
  fetchLearningContent(sid)
    .then((data) => {
      content.value = data
    })
    .catch(() => {
      loading.value = false
    })
    .finally(() => {
      loading.value = false
    })
}

function goToStory() {
  uni.redirectTo({
    url: `/pages/learning/story?storyId=${storyId.value}&assignmentId=${assignmentId.value}`
  })
}

async function handleRegenerate() {
  if (!assignmentId.value) return
  generating.value = true
  progress.value = 0
  const timer = setInterval(() => {
    progress.value = Math.min(progress.value + 10, 90)
  }, 500)
  try {
    await generateContent(assignmentId.value)
    progress.value = 100
    clearInterval(timer)
    uni.showToast({ title: '生成完成', icon: 'success' })
    setTimeout(() => {
      generating.value = false
      loadData()
    }, 500)
  } catch (err) {
    clearInterval(timer)
    generating.value = false
    uni.showToast({ title: '重新生成失败', icon: 'none' })
  }
}
</script>

