  font-size: 26rpx;
  color: #666;
}

.footer {
  padding: 24rpx 32rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.primary-btn {
  height: 88rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.secondary-btn {
  height: 80rpx;
