  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.progress-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.generating-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

