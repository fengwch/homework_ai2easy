<template>
  <view class="container">
    <view v-if="loading" class="loading">
      <text>加载中...</text>
    </view>
    
    <view v-else-if="currentQuestion" class="content">
      <view class="progress-bar">
        <view class="progress-fill" :style="{ width: progressPercent + '%' }"></view>
      </view>
      
      <view class="question-header">
        <text class="question-number">第{{ currentIndex + 1 }}题 / 共{{ questions.length }}题</text>
      </view>

      <scroll-view scroll-y class="question-content">
        <view class="question-card">
          <text class="question-text">{{ (currentQuestion as any).original_text ?? currentQuestion.originalText }}</text>
          
          <view v-if="currentQuestion.structuredData?.options" class="options">
            <view
              v-for="option in currentQuestion.structuredData.options"
              :key="option.option"
              class="option-item"
              :class="{ selected: selectedAnswer === option.option }"
              @click="selectOption(option.option)"
            >
              <text class="option-label">{{ option.option }}.</text>
              <text class="option-text">{{ option.text }}</text>
            </view>
          </view>

          <view v-else class="answer-input">
            <textarea
              v-model="textAnswer"
              placeholder="请输入答案"
              class="textarea"
              maxlength="500"
            />
          </view>
        </view>

        <view v-if="showFeedback" class="feedback">
          <view class="feedback-icon" :class="{ correct: isCorrect, wrong: !isCorrect }">
            <text>{{ isCorrect ? '✓' : '✗' }}</text>
          </view>
          <text class="feedback-text">{{ feedbackText }}</text>
        </view>
      </scroll-view>

      <view class="footer-actions">
        <button
          v-if="currentIndex > 0"
          class="prev-btn"
          @click="prevQuestion"
        >
          上一题
        </button>
        <button
          v-if="showHint"
          class="hint-btn"
          @click="showHintModal = true"
        >
          提示
        </button>
        <button
          class="submit-btn"
          :disabled="!hasAnswer"
          @click="handleSubmit"
        >
          {{ currentIndex === questions.length - 1 ? '提交答案' : '下一题' }}
        </button>
      </view>
    </view>

    <!-- 提示模态框 -->
    <view v-if="showHintModal" class="modal" @click="showHintModal = false">
      <view class="modal-content" @click.stop>
        <text class="modal-title">提示</text>
        <text class="modal-text">{{ currentQuestion.structuredData?.analysis || '暂无提示' }}</text>
        <button class="modal-btn" @click="showHintModal = false">知道了</button>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue'
import { fetchAssignmentDetail } from '@/api/assignment'
import { submitAnswer } from '@/api/content'
import type { Question, AssignmentDetail } from '@/api/assignment'

const questions = ref<Question[]>([])
const currentIndex = ref(0)
const selectedAnswer = ref('')
const textAnswer = ref('')
const loading = ref(true)
const storyId = ref('')
const showFeedback = ref(false)
const isCorrect = ref(false)
const feedbackText = ref('')
const showHintModal = ref(false)
const showHint = ref(true)
const assignmentId = ref<number>(0)

const currentQuestion = computed(() => questions.value[currentIndex.value])
const progressPercent = computed(() => {
  return questions.value.length > 0 ? ((currentIndex.value + 1) / questions.value.length) * 100 : 0
})
/** 当前题目是否为选择题（有 options） */
const isChoiceQuestion = computed(() => {
  const q: any = currentQuestion.value
  const opts = q?.structuredData?.options
  return Array.isArray(opts) && opts.length > 0
})
/** 是否有可用于提交的答案；非选择题默认允许直接点击下一题 */
const hasAnswer = computed(() => {
  if (isChoiceQuestion.value) {
    return selectedAnswer.value !== '' || textAnswer.value.trim() !== ''
  }
  return true
})

onMounted(() => {
  loadQuestions()
})

function loadQuestions() {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = currentPage.options || {}
  const id = parseInt(options.assignmentId || '0')
  const urlStoryId = options.storyId || ''
  const qIdx = options.questionIndex != null ? parseInt(String(options.questionIndex), 10) : NaN
  
  if (!id) {
    uni.showToast({
      title: '作业ID无效',
      icon: 'none'
    })
    setTimeout(() => {
      uni.navigateBack()
    }, 1500)
    return
  }
  
  assignmentId.value = id
  if (urlStoryId) {
    storyId.value = urlStoryId
  }
  loading.value = true
  
  fetchAssignmentDetail(id)
    .then((data: AssignmentDetail) => {
      questions.value = data.questions || []
      if (!isNaN(qIdx) && qIdx >= 0 && qIdx < questions.value.length) {
        currentIndex.value = qIdx
      }
      if (!storyId.value) {
        const gc: any = data.generated_content
        const sid = gc?.storyId ?? gc?.story_id
        if (sid) {
          storyId.value = sid
        }
      }
      if (questions.value.length === 0) {
        uni.showToast({
          title: '暂无题目',
          icon: 'none'
        })
      }
    })
    .catch((err) => {
      console.error('加载题目失败:', err)
      uni.showToast({
        title: '加载失败',
        icon: 'none'
      })
    })
    .finally(() => {
      loading.value = false
    })
}

function selectOption(option: string) {
  selectedAnswer.value = option
  textAnswer.value = ''
}

async function handleSubmit() {
  // 非选择题：不提交后端，直接跳到下一题或结束
  if (!isChoiceQuestion.value) {
    if (currentIndex.value === questions.value.length - 1) {
      // 最后一题，直接弹完成提示并跳转
      setTimeout(() => {
        uni.showModal({
          title: '完成',
          content: '恭喜完成所有题目！',
          showCancel: false,
          success: () => {
            uni.redirectTo({
              url: `/pages/assignment/review?assignmentId=${assignmentId.value}`
            })
          }
        })
      }, 500)
    } else {
      nextQuestion()
    }
    return
  }

  if (!hasAnswer.value) {
    uni.showToast({
      title: '请先选择或输入答案',
      icon: 'none'
    })
    return
  }

  const answer = selectedAnswer.value || textAnswer.value.trim()

  const q = currentQuestion.value
  const qRaw = q as any
  const qGc = qRaw?.generated_content ?? qRaw?.generatedContent
  const effectiveStoryId = storyId.value || qGc?.storyId || qGc?.story_id || ''

  try {
    const result = await submitAnswer(q.id, answer, {
      storyId: effectiveStoryId || undefined,
      assignmentId: assignmentId.value || undefined
    })
    isCorrect.value = result.isCorrect
    feedbackText.value = result.feedback || (result.isCorrect ? '回答正确！' : '回答错误，请再想想')
    showFeedback.value = true
    
    if (currentIndex.value === questions.value.length - 1) {
      // 最后一题，提交整个作业
      setTimeout(() => {
        uni.showModal({
          title: '完成',
          content: '恭喜完成所有题目！',
          showCancel: false,
          success: () => {
            uni.redirectTo({
              url: `/pages/assignment/review?assignmentId=${assignmentId.value}`
            })
          }
        })
      }, 1500)
    } else {
      // 下一题
      setTimeout(() => {
        nextQuestion()
      }, 2000)
    }
  } catch (err) {
    console.error('提交答案失败:', err)
    uni.showToast({
      title: '提交失败，请重试',
      icon: 'none'
    })
  }
}

function nextQuestion() {
  if (currentIndex.value < questions.value.length - 1) {
    currentIndex.value++
    selectedAnswer.value = ''
    textAnswer.value = ''
    showFeedback.value = false
  }
}

function prevQuestion() {
  if (currentIndex.value > 0) {
    currentIndex.value--
    selectedAnswer.value = ''
    textAnswer.value = ''
    showFeedback.value = false
  }
}
</script>

<style scoped lang="scss">
