  margin-bottom: 24rpx;
}

.knowledge-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.knowledge-topic {
  font-size: 28rpx;
  color: #333;
}

.knowledge-rate {
  font-size: 26rpx;
  color: #667eea;
  font-weight: bold;
}

.progress-bar {
  height: 8rpx;
  background: #f5f5f5;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
