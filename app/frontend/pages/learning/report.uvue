<template>
  <view class="container">
    <view class="header">
      <text class="title">学习报告</text>
      <view class="tabs">
        <text
          v-for="tab in tabs"
          :key="tab.value"
          class="tab-item"
          :class="{ active: currentTab === tab.value }"
          @click="switchTab(tab.value)"
        >
          {{ tab.label }}
        </text>
      </view>
    </view>

    <scroll-view scroll-y class="content">
      <view v-if="loading" class="loading">
        <text>加载中...</text>
      </view>

      <view v-else-if="report" class="report-content">
        <!-- 总体统计 -->
        <view class="stats-section">
          <view class="stat-card">
            <text class="stat-value">{{ report.totalQuestions }}</text>
            <text class="stat-label">总题数</text>
          </view>
          <view class="stat-card">
            <text class="stat-value">{{ report.correctCount }}</text>
            <text class="stat-label">正确</text>
          </view>
          <view class="stat-card">
            <text class="stat-value">{{ report.wrongCount }}</text>
            <text class="stat-label">错误</text>
          </view>
          <view class="stat-card">
            <text class="stat-value">{{ report.correctRate }}%</text>
            <text class="stat-label">正确率</text>
          </view>
        </view>

        <!-- 学习时长 -->
        <view class="section">
          <text class="section-title">学习时长</text>
          <view class="time-card">
            <text class="time-value">{{ formatTime(report.timeSpent) }}</text>
            <text class="time-label">分钟</text>
          </view>
        </view>

        <!-- 知识点掌握情况 -->
        <view class="section">
          <text class="section-title">知识点掌握情况</text>
          <view
            v-for="kp in report.knowledgePoints"
            :key="kp.topic"
            class="knowledge-item"
          >
            <view class="knowledge-header">
              <text class="knowledge-topic">{{ kp.topic }}</text>
              <text class="knowledge-rate">{{ kp.masteryRate }}%</text>
            </view>
            <view class="progress-bar">
              <view
                class="progress-fill"
                :style="{ width: kp.masteryRate + '%' }"
              ></view>
            </view>
          </view>
        </view>
      </view>

      <view v-else class="empty">
        <text>暂无报告数据</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { fetchLearningReport } from '@/api/content'
import type { LearningReport } from '@/api/content'

const report = ref<LearningReport | null>(null)
const loading = ref(true)
const currentTab = ref('day')

const tabs = [
  { label: '日报', value: 'day' },
  { label: '周报', value: 'week' },
  { label: '月报', value: 'month' }
]

onMounted(() => {
  loadReport()
})

function loadReport() {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = currentPage.options || {}
  const assignmentId = parseInt(options.assignmentId || '0')
  
  if (!assignmentId) {
    uni.showToast({
      title: '作业ID无效',
      icon: 'none'
    })
    setTimeout(() => {
      uni.navigateBack()
    }, 1500)
    return
  }
  
  loading.value = true
  
  fetchLearningReport(assignmentId)
    .then((data) => {
      report.value = data
    })
    .catch((err) => {
      console.error('加载报告失败:', err)
      uni.showToast({
        title: '加载失败',
        icon: 'none'
      })
    })
    .finally(() => {
      loading.value = false
    })
}

function switchTab(tab: string) {
  currentTab.value = tab
  loadReport()
}

function formatTime(minutes: number): string {
  if (minutes < 60) {
    return `${minutes}`
  }
  const hours = Math.floor(minutes / 60)
  const mins = minutes % 60
  return mins > 0 ? `${hours}小时${mins}分钟` : `${hours}小时`
}
</script>

