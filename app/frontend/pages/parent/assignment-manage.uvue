  margin-bottom: 24rpx;
}

.search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.filters {
  display: flex;
  gap: 16rpx;
}

.filter-item {
  flex: 1;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  text-align: center;
}

.assignment-list {
  height: calc(100vh - 300rpx);
  padding: 32rpx;
}

.loading,
.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999;
}

.assignment-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.assignment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.subject {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #999;
}

.status.completed {
  background: #e8f5e9;
  color: #4caf50;
}

.status.processing {
  background: #fff3cd;
  color: #ffc107;
}

.status.failed {
  background: #fee;
  color: #f56c6c;
}

.date {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 24rpx;
}

.assignment-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
}
</style>
