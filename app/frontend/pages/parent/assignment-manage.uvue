<template>
  <view class="container">
    <view class="header">
      <view class="search-bar">
        <input
          v-model="searchKeyword"
          placeholder="搜索作业"
          class="search-input"
          @input="handleSearch"
        />
      </view>
      <view class="filters">
        <picker :value="subjectIndex" :range="subjects" @change="onSubjectChange">
          <view class="filter-item">{{ selectedSubject || '全部科目' }}</view>
        </picker>
        <picker :value="statusIndex" :range="statuses" @change="onStatusChange">
          <view class="filter-item">{{ selectedStatus || '全部状态' }}</view>
        </picker>
      </view>
    </view>

    <scroll-view scroll-y class="assignment-list">
      <view v-if="loading" class="loading">
        <text>加载中...</text>
      </view>

      <view v-else-if="assignments.length === 0" class="empty">
        <text>暂无作业记录</text>
      </view>

      <view v-else>
        <view
          v-for="assignment in assignments"
          :key="assignment.id"
          class="assignment-card"
          @click="goToDetail(assignment.id)"
        >
          <view class="assignment-header">
            <text class="subject">{{ assignment.subject }}</text>
            <text class="status" :class="assignment.status">{{ getStatusText(assignment.status) }}</text>
          </view>
          <text class="date">{{ formatDate(assignment.createdAt) }}</text>
          <view class="assignment-actions">
            <button class="action-btn" @click.stop="regenerateContent(assignment.id)">重新生成</button>
            <button class="action-btn" @click.stop="exportReport(assignment.id)">导出报告</button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { useUserStore } from '@/stores/user'
import { get } from '@/api/http'
import type { AssignmentDetail } from '@/api/assignment'

const userStore = useUserStore()

const assignments = ref<AssignmentDetail[]>([])
const loading = ref(true)
const searchKeyword = ref('')
const selectedSubject = ref('')
const selectedStatus = ref('')
const subjectIndex = ref(0)
const statusIndex = ref(0)

const subjects = ['全部科目', '数学', '语文', '英语', '科学', '其他']
const statuses = ['全部状态', '待处理', '处理中', '已完成', '失败']

onMounted(() => {
  loadAssignments()
})

function loadAssignments() {
  loading.value = true
  // TODO: 调用实际的作业列表 API
  // fetchAssignments({ childId: userStore.currentChildId.value })
  
  // 使用 mock 数据
  setTimeout(() => {
    assignments.value = []
    loading.value = false
  }, 500)
}

function handleSearch() {
  // TODO: 实现搜索功能
}

function onSubjectChange(e: any) {
  subjectIndex.value = e.detail.value
  selectedSubject.value = subjects[e.detail.value]
  loadAssignments()
}

function onStatusChange(e: any) {
  statusIndex.value = e.detail.value
  selectedStatus.value = statuses[e.detail.value]
  loadAssignments()
}

function getStatusText(status: string): string {
  const statusMap: Record<string, string> = {
    'pending': '待处理',
    'processing': '处理中',
    'completed': '已完成',
    'failed': '失败'
  }
  return statusMap[status] || status
}

function formatDate(date: string): string {
  const d = new Date(date)
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
}

function goToDetail(id: number) {
  uni.navigateTo({ url: `/pages/assignment/detail?id=${id}` })
}

function regenerateContent(id: number) {
  uni.showToast({
    title: '功能开发中',
    icon: 'none'
  })
}

function exportReport(id: number) {
  uni.showToast({
    title: '功能开发中',
    icon: 'none'
  })
}
</script>

<style scoped lang="scss">
