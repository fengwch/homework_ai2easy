<template>
  <view class="container">
    <view class="header">
      <text class="welcome">欢迎，{{ userStore.userInfo.value?.nickname || '家长' }}</text>
      <text class="child-name">{{ currentChildName || '未选择孩子' }}</text>
    </view>

    <!-- 今日学习概览 -->
    <view class="section">
      <text class="section-title">今日学习</text>
      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-value">{{ todayStats.studyTime }}分钟</text>
          <text class="stat-label">学习时长</text>
        </view>
        <view class="stat-card">
          <text class="stat-value">{{ todayStats.completedCount }}</text>
          <text class="stat-label">完成作业</text>
        </view>
        <view class="stat-card">
          <text class="stat-value">{{ todayStats.correctRate }}%</text>
          <text class="stat-label">正确率</text>
        </view>
      </view>
    </view>

    <!-- 最近作业 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">最近作业</text>
        <text class="more-link" @click="goToAssignmentList">查看更多</text>
      </view>
      <view v-if="recentAssignments.length === 0" class="empty">
        <text>暂无作业记录</text>
      </view>
      <view v-else class="assignment-list">
        <view
          v-for="assignment in recentAssignments"
          :key="assignment.id"
          class="assignment-item"
          @click="goToAssignmentDetail(assignment.id)"
        >
          <view class="assignment-info">
            <text class="assignment-subject">{{ assignment.subject }}</text>
            <text class="assignment-date">{{ formatDate(assignment.createdAt) }}</text>
          </view>
          <view class="assignment-status">
            <text class="status-badge" :class="assignment.status">{{ getStatusText(assignment.status) }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="section">
      <text class="section-title">快捷操作</text>
      <view class="action-grid">
        <view class="action-item" @click="goToUpload">
          <text class="action-icon">📷</text>
          <text class="action-label">扫描作业</text>
        </view>
        <view class="action-item" @click="goToReport">
          <text class="action-icon">📊</text>
          <text class="action-label">学习报告</text>
        </view>
        <view class="action-item" @click="goToSettings">
          <text class="action-icon">⚙️</text>
          <text class="action-label">设置</text>
        </view>
        <view class="action-item" @click="goToChildList">
          <text class="action-icon">👶</text>
          <text class="action-label">孩子档案</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue'
import { useUserStore } from '@/stores/user'
import { ensureLoggedInThen } from '@/utils/auth'
import { get } from '@/api/http'
import type { AssignmentDetail } from '@/api/assignment'

const userStore = useUserStore()

const todayStats = ref({
  studyTime: 0,
  completedCount: 0,
  correctRate: 0
})

const recentAssignments = ref<AssignmentDetail[]>([])

const currentChildName = computed(() => {
  const id = userStore.currentChildId.value
  const child = userStore.children.value.find(c => c.id === id)
  return child?.name
})

onMounted(() => {
  ensureLoggedInThen(() => {
    loadDashboardData()
  })
})

function loadDashboardData() {
  // TODO: 调用实际API
  // Promise.all([
  //   get('/api/v1/parent/dashboard/stats'),
  //   get('/api/v1/assignments/recent')
  // ])
  //   .then(([stats, assignments]) => {
  //     todayStats.value = stats
  //     recentAssignments.value = assignments
  //   })
  //   .catch((err) => {
  //     console.error('加载数据失败:', err)
  //   })
  
  // 使用 mock 数据
  todayStats.value = {
    studyTime: 45,
    completedCount: 2,
    correctRate: 85
  }
  
  recentAssignments.value = [
    {
      id: 1,
      childId: 1,
      subject: '数学',
      grade: '三年级',
      originalImages: [],
      questions: [],
      status: 'completed',
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    }
  ]
}

function formatDate(dateStr: string) {
  const date = new Date(dateStr)
  const month = date.getMonth() + 1
  const day = date.getDate()
  return `${month}月${day}日`
}

function getStatusText(status: string) {
  const statusMap: Record<string, string> = {
    pending: '待处理',
    processing: '处理中',
    completed: '已完成',
    failed: '失败'
  }
  return statusMap[status] || status
}

function goToUpload() {
  uni.navigateTo({ url: '/pages/assignment/upload' })
}

function goToReport() {
  uni.navigateTo({ url: '/pages/parent/report' })
}

function goToSettings() {
  uni.navigateTo({ url: '/pages/parent/settings' })
}

function goToChildList() {
  uni.navigateTo({ url: '/pages/child/list' })
}

function goToAssignmentList() {
  uni.navigateTo({ url: '/pages/assignment/list' })
}

function goToAssignmentDetail(id: number) {
  uni.navigateTo({ url: `/pages/assignment/detail?id=${id}` })
}
</script>

