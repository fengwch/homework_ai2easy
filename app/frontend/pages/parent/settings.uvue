<template>
  <view class="container">
    <view class="section">
      <text class="section-title">内容偏好</text>
      <view class="menu-item">
        <text class="menu-text">故事风格</text>
        <picker :value="storyStyleIndex" :range="storyStyles" @change="onStoryStyleChange">
          <view class="picker-view">{{ storyStyle }}</view>
        </picker>
      </view>
      <view class="menu-item">
        <text class="menu-text">难度等级</text>
        <picker :value="difficultyIndex" :range="difficulties" @change="onDifficultyChange">
          <view class="picker-view">{{ difficulty }}</view>
        </picker>
      </view>
    </view>

    <view class="section">
      <text class="section-title">通知设置</text>
      <view class="menu-item">
        <text class="menu-text">作业完成通知</text>
        <switch :checked="notifications.completed" @change="onNotificationChange('completed', $event)" />
      </view>
      <view class="menu-item">
        <text class="menu-text">学习报告通知</text>
        <switch :checked="notifications.report" @change="onNotificationChange('report', $event)" />
      </view>
      <view class="menu-item">
        <text class="menu-text">成就解锁通知</text>
        <switch :checked="notifications.achievement" @change="onNotificationChange('achievement', $event)" />
      </view>
    </view>

    <view class="section">
      <text class="section-title">隐私设置</text>
      <view class="menu-item">
        <text class="menu-text">数据同步</text>
        <switch :checked="privacy.sync" @change="onPrivacyChange('sync', $event)" />
      </view>
      <view class="menu-item">
        <text class="menu-text">匿名模式</text>
        <switch :checked="privacy.anonymous" @change="onPrivacyChange('anonymous', $event)" />
      </view>
    </view>

    <view class="section">
      <text class="section-title">时间限制</text>
      <view class="menu-item">
        <text class="menu-text">每日学习时长限制</text>
        <picker :value="timeLimitIndex" :range="timeLimits" @change="onTimeLimitChange">
          <view class="picker-view">{{ timeLimit }}分钟</view>
        </picker>
      </view>
    </view>

    <button class="save-btn" @click="handleSave">保存设置</button>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { useAppStore } from '@/stores/app'

const appStore = useAppStore()

const storyStyle = ref('生动有趣')
const storyStyleIndex = ref(0)
const storyStyles = ['生动有趣', '简洁明了', '详细深入']

const difficulty = ref('适中')
const difficultyIndex = ref(1)
const difficulties = ['简单', '适中', '困难']

const notifications = ref({
  completed: true,
  report: true,
  achievement: true
})

const privacy = ref({
  sync: true,
  anonymous: false
})

const timeLimit = ref(120)
const timeLimitIndex = ref(2)
const timeLimits = ['60', '90', '120', '180', '240']

function onStoryStyleChange(e: any) {
  storyStyleIndex.value = e.detail.value
  storyStyle.value = storyStyles[e.detail.value]
}

function onDifficultyChange(e: any) {
  difficultyIndex.value = e.detail.value
  difficulty.value = difficulties[e.detail.value]
}

function onNotificationChange(key: string, e: any) {
  notifications.value[key as keyof typeof notifications.value] = e.detail.value
}

function onPrivacyChange(key: string, e: any) {
  privacy.value[key as keyof typeof privacy.value] = e.detail.value
}

function onTimeLimitChange(e: any) {
  timeLimitIndex.value = e.detail.value
  timeLimit.value = parseInt(timeLimits[e.detail.value])
}

function handleSave() {
  // TODO: 保存设置到服务器
  uni.showToast({
    title: '设置已保存',
    icon: 'success'
  })
}
</script>

<style scoped lang="scss">
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.picker-view {
  font-size: 26rpx;
  color: #667eea;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
  margin-top: 32rpx;
}
</style>
