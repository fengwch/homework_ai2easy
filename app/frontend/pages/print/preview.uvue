  padding: 32rpx;
  background: #fff;
  border-bottom: 2rpx solid #f5f5f5;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.preview-content {
  flex: 1;
  padding: 32rpx;
}

.print-page {
  background: #fff;
  padding: 40rpx;
  border-radius: 8rpx;
}

.page-item {
  margin-bottom: 40rpx;
  page-break-after: always;
}

.page-image {
  width: 100%;
  border-radius: 8rpx;
}

.page-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  display: block;
}

.story-header {
  margin-bottom: 32rpx;
}

.story-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.story-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.story-images {
  margin-bottom: 32rpx;
}

.story-image {
  width: 100%;
  display: block;
  margin-bottom: 24rpx;
  border-radius: 8rpx;
}

.story-body {
  margin-bottom: 32rpx;
}

.story-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  display: block;
}

.question-item {
  padding: 24rpx 0;
  border-top: 2rpx solid #eee;
}

.q-label {
  font-size: 24rpx;
  color: #667eea;
  display: block;
  margin-bottom: 8rpx;
}

.q-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
}

.q-options {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 8rpx;
}

.save-tip {
  padding: 24rpx 32rpx;
  text-align: center;
}

.save-tip-text {
  font-size: 26rpx;
  color: #666;
}

.footer {
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 2rpx solid #f5f5f5;
}

.settings {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.setting-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.setting-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.picker-view {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.print-btn {
  width: 100%;
  height: 88rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}
</style>
