<template>
  <view class="container">
    <view class="header">
      <image
        v-if="displayAvatarUrl"
        :src="displayAvatarUrl"
        class="avatar"
        mode="aspectFill"
      />
      <view v-else class="avatar-placeholder">
        <text>{{ userInfo?.nickname?.[0] || 'U' }}</text>
      </view>
      <text class="name">{{ userInfo?.nickname || '用户' }}</text>
      <text class="phone">{{ userInfo?.phone || '' }}</text>
    </view>

    <view class="menu-list">
      <!-- 直接使用 chooseAvatar 获取微信头像（2022.11 起 getUserProfile 已废弃） -->
      <button
        class="menu-item menu-item-btn"
        open-type="chooseAvatar"
        @chooseavatar="onWechatAvatarChosen"
      >
        <text class="menu-icon">👤</text>
        <text class="menu-text">获取更新头像</text>
      </button>

      <!-- 编辑个人信息入口暂隐藏
      <view class="menu-item" @click="goToEdit">
        <text class="menu-icon">✏️</text>
        <text class="menu-text">编辑个人信息</text>
      </view>
      -->

      <!-- 以下入口暂隐藏
      <view class="menu-item" @click="handleSyncWechatProfile">
        <text class="menu-icon">🔄</text>
        <text class="menu-text">同步微信头像昵称</text>
      </view>
      <view class="menu-item" @click="goToSecurity">
        <text class="menu-icon">🔒</text>
        <text class="menu-text">账户安全</text>
      </view>
      -->
      
      <!-- 订阅管理入口：因个人主体不支持电商/订阅付费，先隐藏
      <view class="menu-item" @click="goToSubscription">
        <text class="menu-icon">💎</text>
        <text class="menu-text">订阅管理</text>
      </view>
      -->

      <!-- 设置入口暂隐藏
      <view class="menu-item" @click="goToSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
      </view>
      -->
    </view>

    <button class="logout-btn" @click="handleLogout">退出登录</button>

    <PrivacyPopup />
    <BottomTabBar current="profile" />
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { useUserStore } from '@/stores/user'
import { logout, ensureLoggedInThen } from '@/utils/auth'
import { resolveAvatarUrl } from '@/utils/image'
import { uploadAvatar } from '@/api/user'
import PrivacyPopup from '@/components/common/PrivacyPopup.uvue'
import BottomTabBar from '@/components/common/BottomTabBar.uvue'

const userStore = useUserStore()

const userInfo = computed(() => userStore.userInfo.value)

/** 头像完整 URL（自己上传的相对路径会补全域名，?t= 时间戳用于 CDN 缓存穿透） */
const displayAvatarUrl = computed(() =>
  resolveAvatarUrl(
    userInfo.value?.avatarUrl || userInfo.value?.avatar_url,
    userStore.avatarCacheBuster.value
  )
)

onShow(() => {
  ensureLoggedInThen(() => {})
})

/**
 * 用微信头像（button open-type="chooseAvatar" 回调）
 * 用户点击「获取更新头像」后弹出微信头像选择器，选择后返回临时路径，上传到服务端
 */
function onWechatAvatarChosen(e: { detail?: { avatarUrl?: string } }) {
  const tempPath = e?.detail?.avatarUrl
  if (!tempPath) return
  console.log('[获取更新头像] 头像临时路径:', tempPath)
  console.log('[获取更新头像] userInfo 全部信息:', JSON.stringify(userInfo.value))
  uploadAndUpdateAvatar(tempPath)
}

/**
 * 从相册或拍照上传头像，上传成功后立即更新 store，个人中心头像与昵称会同步刷新
 */
async function uploadAndUpdateAvatar(tempPath: string) {
  if (!tempPath) return
  try {
    uni.showLoading({ title: '上传中...' })
    const result = await uploadAvatar(tempPath)
    const url = result.avatar_url || result.avatarUrl
    if (url) {
      await userStore.syncWechatProfileFromInfo(undefined, url)
      console.log('[获取更新头像] 上传成功，头像地址:', url)
      console.log('[获取更新头像] 更新后 userInfo 全部信息:', JSON.stringify(userStore.userInfo.value))
      uni.showToast({ title: '头像已更新', icon: 'success' })
    } else {
      uni.showToast({ title: '上传失败', icon: 'none' })
    }
  } catch (e) {
    uni.showToast({ title: e instanceof Error ? e.message : '上传失败', icon: 'none' })
  } finally {
    uni.hideLoading()
  }
}

function goToEdit() {
  uni.navigateTo({ url: '/pages/profile/edit' })
}

// 订阅管理入口已隐藏，暂不跳转订阅页
// function goToSubscription() {
//   uni.navigateTo({ url: '/pages/profile/subscription' })
// }

function handleLogout() {
  uni.showModal({
    title: '确认退出',
    content: '确定要退出登录吗？',
    success: (res) => {
      if (res.confirm) {
        logout()
      }
    }
  })
}
</script>

<style scoped lang="scss">
.container {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom) + 24rpx);
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 80rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.menu-list {
  margin-top: 32rpx;
  background: #fff;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item-btn {
  width: 100%;
  margin: 0;
  padding: 32rpx;
  background: #fff;
  border: none;
  border-radius: 0;
  text-align: left;
  line-height: inherit;
}

.menu-item-btn::after {
  border: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.logout-btn {
  margin: 60rpx 32rpx;
  height: 88rpx;
  background: #fff;
  color: #f56c6c;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: 2rpx solid #f56c6c;
}
</style>
