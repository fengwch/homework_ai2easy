<template>
  <view class="container">
    <view class="header">
      <view class="tabs">
        <text
          v-for="tab in tabs"
          :key="tab.value"
          class="tab-item"
          :class="{ active: currentTab === tab.value }"
          @click="switchTab(tab.value)"
        >
          {{ tab.label }}
        </text>
      </view>
    </view>

    <scroll-view scroll-y class="leaderboard-list">
      <view v-if="loading" class="loading">
        <text>加载中...</text>
      </view>

      <view v-else-if="rankings.length === 0" class="empty">
        <text>暂无排行榜数据</text>
      </view>

      <view v-else>
        <!-- 前三名 -->
        <view v-if="rankings.length >= 3" class="top-three">
          <view class="second-place">
            <image
              v-if="rankings[1].avatar"
              :src="rankings[1].avatar"
              class="avatar"
              mode="aspectFill"
            />
            <view v-else class="avatar-placeholder">{{ rankings[1].name[0] }}</view>
            <text class="name">{{ rankings[1].name }}</text>
            <text class="points">{{ rankings[1].points }}分</text>
            <text class="rank">2</text>
          </view>
          
          <view class="first-place">
            <image
              v-if="rankings[0].avatar"
              :src="rankings[0].avatar"
              class="avatar"
              mode="aspectFill"
            />
            <view v-else class="avatar-placeholder">{{ rankings[0].name[0] }}</view>
            <text class="name">{{ rankings[0].name }}</text>
            <text class="points">{{ rankings[0].points }}分</text>
            <text class="rank">1</text>
          </view>
          
          <view class="third-place">
            <image
              v-if="rankings[2].avatar"
              :src="rankings[2].avatar"
              class="avatar"
              mode="aspectFill"
            />
            <view v-else class="avatar-placeholder">{{ rankings[2].name[0] }}</view>
            <text class="name">{{ rankings[2].name }}</text>
            <text class="points">{{ rankings[2].points }}分</text>
            <text class="rank">3</text>
          </view>
        </view>

        <!-- 其他排名 -->
        <view class="other-rankings">
          <view
            v-for="(item, index) in otherRankings"
            :key="item.id"
            class="ranking-item"
            :class="{ 'my-ranking': item.isMe }"
          >
            <text class="rank-number">{{ index + 4 }}</text>
            <image
              v-if="item.avatar"
              :src="item.avatar"
              class="avatar"
              mode="aspectFill"
            />
            <view v-else class="avatar-placeholder">{{ item.name[0] }}</view>
            <view class="info">
              <text class="name">{{ item.name }}</text>
              <text class="grade">{{ item.grade || '' }}</text>
            </view>
            <text class="points">{{ item.points }}分</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue'
import { useUserStore } from '@/stores/user'

const userStore = useUserStore()

const rankings = ref<Array<{
  id: number
  name: string
  avatar?: string
  points: number
  grade?: string
  isMe?: boolean
}>>([])

const loading = ref(true)
const currentTab = ref('week')

const tabs = [
  { label: '周榜', value: 'week' },
  { label: '月榜', value: 'month' },
  { label: '总榜', value: 'all' }
]

const otherRankings = computed(() => {
  return rankings.value.slice(3)
})

onMounted(() => {
  loadRankings()
})

function loadRankings() {
  loading.value = true
  // TODO: 调用实际的排行榜 API
  // fetchLeaderboard(currentTab.value)
  
  // 使用 mock 数据
  setTimeout(() => {
    rankings.value = [
      { id: 1, name: '小明', points: 2500, grade: '三年级' },
      { id: 2, name: '小红', points: 2300, grade: '三年级' },
      { id: 3, name: '小刚', points: 2100, grade: '四年级' },
      { id: 4, name: '小丽', points: 2000, grade: '三年级', isMe: true },
      { id: 5, name: '小强', points: 1900, grade: '四年级' }
    ]
    loading.value = false
  }, 500)
}

function switchTab(tab: string) {
  currentTab.value = tab
  loadRankings()
}
</script>

